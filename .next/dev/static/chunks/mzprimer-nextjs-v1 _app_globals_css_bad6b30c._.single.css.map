    top: -8px !important;
  }

  .pricing-footer {
    padding: 10px 0 20px !important;
  }

  .register-first-btn {
    font-size: 9px !important;
  }
}

/* Small Device Polish (iPhone SE size) */
@media (max-width: 380px) {
  .pricing-card {
    flex: 0 0 150px !important;
  }
}
/* ==========================================
   📱 MOBILE LAYOUT STYLES
   ========================================== */

/* Mobile Layout - Hidden by default on desktop */
.mobile-layout {
  display: none;
  flex-direction: column;
  width: 100%;
  padding: 0.5rem 0.75rem;
}

/* Mobile User Top Section */
.mobile-user-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.4rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 0.1rem;
  width: 100%;
}

.user-info-mobile-top {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex: 1;
}

.user-avatar-mobile {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #FACC15, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 0.75rem;
  color: #000000;
  flex-shrink: 0;
  box-shadow: 0 0 8px rgba(250, 204, 21, 0.2);
}

.user-details-mobile {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-email-mobile {
  color: #FFFFFF;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.1rem;
}

.setup-count-mobile {
  color: #A1A1AA;
  font-size: 0.7rem;
  text-transform: uppercase;
}

/* Mobile Navigation Buttons */
.mobile-nav-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.4rem;
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  animation: slideDownMobile 0.3s ease-out;
}

.mobile-nav-btn {
  padding: 0.75rem 0.5rem;
  background: #0d0d0d;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: #FFFFFF;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: center;
  text-transform: uppercase;
}

.mobile-nav-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(212, 175, 55, 0.3);
}

.mobile-nav-btn.active {
  background: rgba(217, 119, 6, 0.1);
  border-color: rgba(217, 119, 6, 0.3);
  color: #F59E0B;
}

.mobile-nav-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.mobile-nav-btn.logout {
  background: rgba(120, 113, 108, 0.1);
  color: #A8A29E;
  grid-column: span 2;
  border-color: rgba(239, 68, 68, 0.2);
}

.mobile-nav-btn.logout:hover {
  background: rgba(120, 113, 108, 0.2);
  border-color: rgba(239, 68, 68, 0.3);
}

/* Toggle Button */
.nav-toggle-btn-small {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.3);
  color: rgba(212, 175, 55, 0.9);
  padding: 0.4rem 0.8rem;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 900;
  cursor: pointer;
  letter-spacing: 0.1em;
  transition: all 0.2s ease;
}

.nav-toggle-btn-small:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(212, 175, 55, 0.5);
}

/* Logout Button */
.logout-btn-mobile {
  background: rgba(120, 113, 108, 0.1);
  color: #A8A29E;
  border: 1px solid transparent;
  padding: 0.2rem 0.8rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.logout-btn-mobile:hover {
  background: rgba(120, 113, 108, 0.2);
  border-color: rgba(120, 113, 108, 0.3);
}

/* ==========================================
   🖥️ DESKTOP LAYOUT STYLES
   ========================================== */

/* Desktop Layout - Hidden by default on mobile */
.desktop-layout {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 2rem;
  width: 100%;
}

.nav-buttons {
  display: flex;
  gap: 0.5rem;
}

.user-section {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.user-info-simple {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: #D1D5DB;
}

/* ==========================================
   📱 MOBILE RESPONSIVE BREAKPOINTS
   ========================================== */

@media (max-width: 768px) {
  /* Hide desktop layout on mobile */
  .desktop-layout {
    display: none !important;
  }
  
  /* Show mobile layout on mobile */
  .mobile-layout {
    display: flex !important;
  }
  
  /* Fix header height for mobile */
  .simple-header {
    height: auto !important;
    min-height: 60px;
    padding: 10px 0;
  }
  
  /* Adjust main content padding */
  .cabinet-main {
    padding-top: 80px;
  }
  
  /* Mobile dropdown menu */
  .mobile-nav-dropdown {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    animation: slideDownMobile 0.3s ease-out;
  }
}

/* ==========================================
   🖥️ DESKTOP RESPONSIVE BREAKPOINTS
   ========================================== */

@media (min-width: 769px) {
  /* Hide mobile layout on desktop */
  .mobile-layout {
    display: none !important;
  }
  
  /* Show desktop layout on desktop */
  .desktop-layout {
    display: flex;
  }
}

/* ==========================================
   🎬 ANIMATIONS
   ========================================== */

@keyframes slideDownMobile {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* ==========================================
   🏛️ EXECUTIVE DASHBOARD: BLACK, WHITE & GOLD
   Theme: Institutional Minimalism
   ========================================== */

:root {
  --obsidian: #050505;
  --matte-black: #0d0d0d;
  --gold-primary: #d4af37;
  --gold-soft: #f1d592;
  --gold-border: rgba(212, 175, 55, 0.15);
  --text-silk: #f8fafc;
  --text-dim: #64748b;
  --ruby: #ef4444;
}

/* --- 1. GLOBAL UI --- */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background-color: var(--obsidian);
  color: var(--text-silk);
  font-family: 'Inter', sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* --- 2. HEADER & NAVIGATION --- */
.simple-header {
  position: fixed;
  top: 0; left: 0; width: 100%;
  height: 56px;
  background: rgba(5, 5, 5, 0.9);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid var(--gold-border);
  z-index: 2000;
  display: flex;
  align-items: center;
}

/* Desktop Only Navigation */
@media (min-width: 769px) {
  .desktop-layout {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    padding: 0 24px;
  }

  .nav-buttons { display: flex; gap: 6px; }

  .nav-btn {
    background: transparent;
    color: var(--text-dim);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 8px 14px;
    border-radius: 4px;
    transition: 0.2s;
  }

  .nav-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
  .nav-btn.active { color: var(--gold-primary); background: rgba(212, 175, 55, 0.05); }
}

/* --- 3. MOBILE MENU & NAVIGATION --- */
@media (max-width: 768px) {
  .desktop-layout { display: none !important; }
  
  .simple-header { height: auto; padding: 12px 0; }
  
  .mobile-layout { width: 100%; padding: 0 15px; display: flex; flex-direction: column; }
  
  .mobile-user-top { display: flex; justify-content: space-between; align-items: center; }

  .nav-toggle-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--gold-border);
    color: var(--gold-primary);
    padding: 6px 14px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    border-radius: 4px;
  }

  .mobile-nav-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-btn {
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
  }

  .mobile-nav-btn.active { background: var(--gold-primary); color: #000; border: none; }
  
  /* Mobile Logout Specific */
  .mobile-nav-btn.logout {
    grid-column: span 2;
    background: rgba(239, 68, 68, 0.05);
    color: var(--ruby);
    border-color: rgba(239, 68, 68, 0.1);
    margin-top: 4px;
  }
}

/* --- 4. EXECUTIVE LOGOUT BUTTON (Header) --- */
.logout-btn-simple {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-dim);
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 6px 12px;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s;
  margin-left: 1rem;
}

.logout-btn-simple:hover {
  border-color: var(--ruby);
  color: var(--ruby);
  background: rgba(239, 68, 68, 0.05);
}

/* --- 5. DATA CARDS (Petite Style) --- */
.status-card {
  background: var(--matte-black);
  border: 1px solid var(--gold-border);
  border-radius: 20px;
  padding: 40px 20px;
  text-align: center;
  margin-bottom: 2rem;
}

.count-number {
  font-family: 'JetBrains Mono', monospace;
  font-size: 4rem;
  font-weight: 200;
  color: #fff;
}

.action-card {
  background: var(--matte-black);
  border: 1px solid var(--gold-border);
  border-radius: 16px;
  padding: 25px;
  text-align: center;
  transition: 0.3s;
}

.action-card:hover { border-color: var(--gold-primary); transform: translateY(-4px); }

/* --- 6. BUTTONS (Standard Gold) --- */
.btn-gold, .action-btn.primary {
  background: var(--gold-primary) !important;
  color: #000 !important;
  font-weight: 900;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 12px 24px;
  border-radius: 8px;
  border: none;
}

.btn-ghost-gold, .action-btn.secondary {
  background: transparent !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, 0.2) !important;
  font-weight: 700;
  font-size: 10px;
  text-transform: uppercase;
  padding: 11px 24px;
  border-radius: 8px;
}

.btn-ghost-gold:hover { border-color: #fff !important; }

/* --- 7. PURCHASE CARDS --- */
.purchase-grid {
  display: flex;
  justify-content: center;
  gap: 12px;
  padding: 20px 0;
}

.purchase-option {
  flex: 0 0 200px;
  background: #0a0a0a;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  padding: 25px 15px;
  text-align: center;
}

.popular-plan { border-color: var(--gold-primary); background: linear-gradient(180deg, rgba(212, 175, 55, 0.03), #0a0a0a); }

.plan-price { font-family: 'JetBrains Mono', monospace; font-size: 1.6rem; font-weight: 200; margin: 8px 0; }

/* --- 8. MOBILE SCROLL FIX --- */
@media (max-width: 600px) {
  .purchase-grid { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; padding: 20px; }
  .purchase-grid::-webkit-scrollbar { display: none; }
  .purchase-option { flex: 0 0 170px; }
  .cabinet-main { padding-top: 85px; }
}
/* ==========================================
   🏛️ EXECUTIVE DASHBOARD: GOLD, BLACK & WHITE
   Theme: Obsidian & Institutional Lux
   ========================================== */

:root {
  --obsidian: #050505;
  --matte-black: #0d0d0d;
  --gold-primary: #d4af37;
  --gold-soft: #f1d592;
  --gold-border: rgba(212, 175, 55, 0.15);
  --text-silk: #f8fafc;
  --text-dim: #64748b;
  --emerald: #10b981;
  --ruby: #ef4444;
}

/* --- 1. BASE RESET --- */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background-color: var(--obsidian);
  color: var(--text-silk);
  font-family: 'Inter', -apple-system, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* --- 2. EXECUTIVE BUTTONS --- */
.btn-gold, .btn-primary {
  background: var(--gold-primary) !important;
  color: #000 !important;
  font-weight: 900;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.1em;
  padding: 12px 24px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
}

.btn-gold:hover { background: var(--gold-soft) !important; transform: translateY(-2px); }

.btn-ghost-gold, .btn-secondary {
  background: transparent !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, 0.2) !important;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.1em;
  padding: 11px 24px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-ghost-gold:hover {
  border-color: var(--gold-primary) !important;
  color: var(--gold-primary) !important;
}

/* --- 3. TINY ELEGANT HEADER --- */
.simple-header {
  position: fixed;
  top: 0; left: 0; width: 100%;
  height: 54px;
  background: rgba(5, 5, 5, 0.9);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid var(--gold-border);
  z-index: 2000;
  display: flex;
  align-items: center;
}

/* Desktop Navigation */
.desktop-layout {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  padding: 0 24px;
}

.nav-buttons { display: flex; gap: 8px; }

.nav-btn {
  background: transparent;
  color: var(--text-dim);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  padding: 8px 16px;
  border-radius: 4px;
  transition: 0.2s;
}

.nav-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
.nav-btn.active { color: var(--gold-primary); background: rgba(212, 175, 55, 0.05); }

/* --- 4. STATUS CARD (CREDITS) --- */
.status-card {
  background: var(--matte-black);
  border: 1px solid var(--gold-border);
  border-radius: 24px;
  padding: 40px;
  text-align: center;
  margin-bottom: 2rem;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

.status-header h2 {
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  color: var(--text-dim);
}

.count-number {
  font-family: 'JetBrains Mono', monospace;
  font-size: 4.5rem;
  font-weight: 200; /* THIN LUXURY SHRIFT */
  color: #fff;
  margin: 10px 0;
}

.count-label {
  font-size: 11px;
  color: var(--gold-primary);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* --- 5. ACTION GRID --- */
.actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  margin-bottom: 4rem;
}

.action-card {
  background: var(--matte-black);
  border: 1px solid var(--gold-border);
  border-radius: 16px;
  padding: 30px 20px;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-card:hover { border-color: var(--gold-primary); transform: translateY(-4px); }

.action-card h3 { font-size: 13px; font-weight: 900; text-transform: uppercase; color: #fff; margin: 15px 0 8px; }
.action-card p { font-size: 12px; color: var(--text-dim); margin-bottom: 20px; }

/* --- 6. PETITE PURCHASE CARDS --- */
.purchase-grid {
  display: flex;
  justify-content: center;
  gap: 12px;
  padding: 20px;
}

.purchase-option {
  flex: 0 0 200px; /* ELEGANT NARROW WIDTH */
  background: #0a0a0a;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  padding: 30px 15px;
  text-align: center;
}

.popular-plan { border-color: var(--gold-primary); background: linear-gradient(180deg, rgba(212, 175, 55, 0.03), #0a0a0a); }

.plan-price {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.8rem;
  font-weight: 200;
  margin: 15px 0;
}

/* --- 7. MOBILE REFINEMENT --- */
@media (max-width: 768px) {
  .desktop-layout { display: none !important; }
  
  .simple-header { height: auto; padding: 12px 0; }
  
  .mobile-layout { width: 100%; padding: 0 15px; display: flex; flex-direction: column; }
  
  .mobile-user-top { display: flex; justify-content: space-between; align-items: center; }

  .mobile-nav-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-btn {
    background: #0d0d0d;
    border: 1px solid var(--gold-border);
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
  }
  
  .mobile-nav-btn.active { background: var(--gold-primary); color: #000; }

  .purchase-grid { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
  .purchase-option { flex: 0 0 170px; }
  .count-number { font-size: 3rem; }
  .cabinet-main { padding-top: 80px; }
}

/* --- 8. IMMERSIVE PORTAL BLUR --- */
.immersive-modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(25px) saturate(180%);
  -webkit-backdrop-filter: blur(25px) saturate(180%);
  z-index: 10000;
}

.immersive-header {
  height: 60px;
  background: #000;
  border-bottom: 1px solid var(--gold-border);
  padding: 0 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tool-identity { color: var(--gold-primary); font-weight: 900; font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; }

/* Spin Animation */
@keyframes spin { to { transform: rotate(360deg); } }
/* ==========================================
   📡 DYNAMIC STATUS INDICATORS
   ========================================== */

.status-badge {
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid transparent;
}

/* --- ACTIVE STATUS (Green Breathing) --- */
.status-badge.active {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
  border-color: rgba(16, 185, 129, 0.2);
  box-shadow: 0 0 15px rgba(16, 185, 129, 0.1);
  animation: breatheGreen 3s infinite ease-in-out;
}

.status-badge.active::before {
  content: "";
  width: 6px;
  height: 6px;
  background: #10b981;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 0 8px #10b981;
}

@keyframes breatheGreen {
  0%, 100% { opacity: 1; box-shadow: 0 0 5px rgba(16, 185, 129, 0.2); }
  50% { opacity: 0.8; box-shadow: 0 0 15px rgba(16, 185, 129, 0.5); }
}

/* --- INACTIVE STATUS (Red Alert Pulse) --- */
.status-badge.inactive {
  background: rgba(239, 68, 68, 0.05);
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.2);
  animation: pulseRed 2s infinite ease-in-out;
}

.status-badge.inactive::before {
  content: "";
  width: 6px;
  height: 6px;
  background: #ef4444;
  border-radius: 50%;
  display: inline-block;
}

@keyframes pulseRed {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.7; }
  100% { transform: scale(1); opacity: 1; }
}
/* ==========================================
   📱 MOBILE REFINEMENT: CENTERED & PETITE
   ========================================== */

@media (max-width: 768px) {
  /* 1. Main Container Spacing */
  .cabinet-main {
    padding-left: 24px !important;  /* Creates breathing room from edge */
    padding-right: 24px !important;
    padding-top: 80px;
  }

  .dashboard-view {
    display: flex;
    flex-direction: column;
    align-items: center; /* Centers all child containers */
  }

  /* 2. Welcome Section (Centered & Narrow) */
  .welcome-section {
    text-align: center;
    width: 100%;
    margin-bottom: 2rem;
  }

  .welcome-section h1 {
    font-size: 1.8rem !important;
    text-align: center;
    max-width: 300px;
    margin: 0 auto 10px auto;
  }

  .welcome-section p {
    font-size: 13px !important;
    color: var(--text-dim);
    text-align: center;
    max-width: 280px; /* Limits width to keep it centered and elegant */
    margin: 0 auto;
  }

  /* 3. Cards Spacing (Restricting Width) */
  .status-card, .action-card {
    width: 100%;
    max-width: 340px; /* Prevents card from hitting the edges */
    margin-left: auto !important;
    margin-right: auto !important;
    padding: 24px 20px !important;
  }

  /* 4. Action Grid Alignment */
  .actions-grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center; /* Ensures cards stack centrally */
    gap: 16px;
  }

  /* 5. Purchase Grid (Center the scroller) */
  .purchase-grid {
    justify-content: flex-start;
    padding: 20px 0;
    width: 100vw;
    margin-left: -24px; /* Counter-act main padding for full-bleed scroll */
    padding-left: 24px;
    padding-right: 24px;
  }

  /* 6. Titles & Subtitles in Cards */
  .status-header h2, .action-card h3 {
    text-align: center;
    width: 100%;
  }

  .action-card p {
    text-align: center;
    max-width: 220px;
    margin: 0 auto 15px;
  }
}

/* Extra Small Devices (iPhone SE, etc) */
@media (max-width: 380px) {
  .status-card, .action-card {
    max-width: 290px;
  }
}
/* ==========================================
   🎯 WELCOME SECTION: UNIVERSAL CENTERING
   ========================================== */

.welcome-section {
  width: 100%;
  text-align: center;
  margin-bottom: 3.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-section h1 {
  font-size: 2.5rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  margin-bottom: 12px;
  /* Gold-to-White Executive Gradient */
  background: linear-gradient(135deg, var(--gold-primary) 0%, #ffffff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.welcome-section p {
  font-size: 1rem;
  font-weight: 300;
  color: var(--text-dim);
  max-width: 500px; /* Restricts line length for elegance */
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
  letter-spacing: 0.02em;
}

/* Mobile Tweak for Shorter Headlines */
@media (max-width: 768px) {
  .welcome-section h1 {
    font-size: 1.8rem;
    padding: 0 20px;
  }
  .welcome-section p {
    font-size: 0.9rem;
    padding: 0 30px;
    max-width: 320px;
  }
}