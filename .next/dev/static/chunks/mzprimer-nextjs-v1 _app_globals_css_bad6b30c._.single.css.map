/* Zone Bar Animations */
@keyframes price-pulse {
  0%, 100% {
    box-shadow: 0 0 15px #ffffff;
  }
  50% {
    box-shadow: 0 0 25px #ffffff, 0 0 35px rgba(255, 255, 255, 0.3);
  }
}

@keyframes dot-pulse {
  0%, 100% {
