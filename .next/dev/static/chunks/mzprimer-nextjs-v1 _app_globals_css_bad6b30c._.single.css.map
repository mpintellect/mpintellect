@tailwind base;
@tailwind components;
@tailwind utilities;
  
/* === Reset & Base === */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  height: 100%;
  width: 100%;
  overflow-x: hidden; /* Keep this on HTML */
}

body {
  min-height: 100vh;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  font-family: 'Inter', sans-serif;
  background-color: #000;
  color: #fff;
  line-height: 1.6;
  padding-top: 80px;
}

/* === Typography === */
h1, h2, h3, h4, h5, h6 {
  font-weight: bold;
  color: #fff;
  margin-bottom: 1rem;
}

p {
  color: #ccc;
  margin-bottom: 1rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.7;
}

/* === Elegant Primary Button === */
.btn-primary {
  /* Premium Gradient */
  background: linear-gradient(135deg, #FACC15 0%, #EAB308 100%);
  color: #000000;

  /* Typography */
  font-family: inherit;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  text-decoration: none;
  
  /* Shape & Box Model */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 32px;
  border-radius: 50px; /* Smooth Pill Shape */
  border: none;
  min-width: 180px; /* Ensure good touch target on mobile */
  
  /* Effects */
  position: relative;
  overflow: hidden;
  cursor: pointer;
  z-index: 1;
  
  /* Depth: Outer Glow + Inner Bevel Highlight */
  box-shadow: 
    0 4px 15px rgba(234, 179, 8, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);

  /* Transitions */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  
  /* Mobile Clean-up */
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

/* Hover State (Desktop) */
.btn-primary:hover {
  background: linear-gradient(135deg, #FDE047 0%, #FACC15 100%); /* Slightly brighter */
  transform: translateY(-2px) scale(1.02);
  box-shadow: 
    0 8px 25px rgba(234, 179, 8, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

/* Active State (Click/Touch) */
.btn-primary:active {
  transform: translateY(1px) scale(0.98);
  box-shadow: 
    0 2px 8px rgba(234, 179, 8, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  filter: brightness(0.95);
}

/* Shine Effect Overlay */
.btn-primary::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(
    to right,
    transparent 0%,
    rgba(255, 255, 255, 0.4) 50%,
    transparent 100%
  );
  transform: skewX(-25deg);
  z-index: -1;
  transition: none; /* Reset transition to allow animation */
}

/* Trigger Shine on Hover */
.btn-primary:hover::after {
  animation: shine 0.75s ease-in-out;
}

@keyframes shine {
  0% { left: -100%; opacity: 0; }
  50% { opacity: 1; }
  100% { left: 200%; opacity: 0; }
}

/* Mobile Specific Adjustments */
@media (max-width: 480px) {
  .btn-primary {
    width: 100%;          /* Full width on small screens */
    max-width: 280px;     /* But verify it doesn't look huge */
    padding: 14px 24px;   /* Slightly tighter padding */
    font-size: 0.95rem;
  }
}
/* === Navbar Styles === */
nav {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  background-color: #000;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 1rem 1.5rem;
  z-index: 50;
  gap: 1.5rem;
}

nav a {
  color: #fff;
  font-weight: 500;
  font-size: 0.875rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #d4af37;
}

/* === Contact Form === */
.contact-form {
  max-width: 600px;
  width: 100%;
  margin: 0 auto;
  text-align: left;
  padding: 2rem;
  background-color: #111;
  border-radius: 1rem;
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.1);
}

.contact-form label {
  display: block;
  color: #fff;
  margin-bottom: 0.5rem;
  font-weight: 500;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  background-color: #1a1a1a;
  border: 1px solid #333;
  color: #fff;
  padding: 0.75rem;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
  font-size: 0.95rem;
  transition: border-color 0.3s;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: #d4af37;
  outline: none;
}

.contact-form button {
  @apply btn-primary;
}

/* === Hide Scrollbar === */
::-webkit-scrollbar {
  display: none;
}
/* ───────────────────────────────
   HERO SECTION (Premium Style)
──────────────────────────────── */

#hero {
  position: relative;
  /* Deep background with top-center spotlight */
  background-color: var(--bg-deep);
  background-image: radial-gradient(circle at 50% 20%, #1a1a1a 0%, #000000 80%);
  
  /* Spacing */
  min-height: 85vh; /* Occupy most of the screen */
  padding-top: 140px; /* Clear fixed header */
  padding-bottom: 4rem;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
  
  /* Layout */
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
}

/* Subtle Grid Background Overlay */
#hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(circle at 50% 20%, black 30%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

/* Logo Styling */
#hero img {
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 0 30px rgba(255, 255, 255, 0.15));
  transition: transform 0.5s ease;
  margin-bottom: 2rem;
}

#hero img:hover {
  transform: scale(1.05);
}

/* Headline */
#hero h1 {
  position: relative;
  z-index: 1;
  font-size: 4rem;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 1.5rem;
  
  /* Metallic Gradient Text */
  background: linear-gradient(180deg, #FFFFFF 0%, #9ca3af 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 20px 40px rgba(0,0,0,0.5);
}

/* Gold Accent Text in Headline */
.hero-gold {
  background: linear-gradient(135deg, var(--gold) 0%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 20px rgba(250, 204, 21, 0.3));
}

/* Subtitle */
#hero p {
  position: relative;
  z-index: 1;
  color: var(--text-muted);
  font-size: 1.25rem;
  line-height: 1.6;
  font-weight: 400;
  max-width: 600px;
  margin: 0 auto 3rem auto;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  #hero {
    min-height: auto;
    padding-top: 120px;
    padding-bottom: 3rem;
    background-image: radial-gradient(circle at 50% 10%, #222 0%, #000 90%);
  }

  #hero h1 {
    font-size: 2.5rem;
  }

  #hero p {
    font-size: 1rem;
    padding: 0 1rem;
  }
  
  #hero img {
    width: 140px;
    margin-bottom: 1.5rem;
  }
}

/* === Sticky Logo Positioning === */
.sticky-logo {
  position: fixed;
  top: 1.3rem;
  left: 1rem;
  z-index: 9999;
  opacity: 1;
  transition: all 0.3s ease;
  width: 38px;
  height: auto;
}

/* Move to right on small screens */
@media (max-width: 767px) {
  .sticky-logo {
    left: auto;
    right: 1rem;
  }
}

/* Optional fade-in logic */
.sticky-logo.hidden {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.95);
}

.sticky-logo.visible {
  opacity: 1;
  pointer-events: auto;
  transform: scale(1);
}

.sticky-logo-img {
  width: 100%;
  height: 80px;
  margin-top: -10px;
  object-fit: contain;
}
/* === AI Robot Section Styling === */
/* === Clean One-Line Footer === */
.footer-one-line {
  background-color: #0a0a0a;
  padding: 1.2rem 2rem;
  border-top: 1px solid #222;
  color: #aaa;
  font-size: 0.85rem;
}

.footer-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.footer-logo {
  height: 34px;
  width: auto;
  filter: brightness(1.3);
}

.footer-text {
  white-space: nowrap;
  font-weight: 400;
  color: #999;
}

/* === Shared Card Responsiveness Fix (AI Tools + Learning) === */

.robot-card {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

@media (max-width: 768px) {
 .robot-card {
    padding: 1.25rem;
    border-radius: 1rem;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.03);
  }
  .robot-name {
    font-size: 1.25rem;
  }
  .robot-description {
    font-size: 0.9rem;
  }
  .robot-buy-button {
    width: 100%;
    text-align: center;
    font-size: 0.9rem;
  }
}

/* Touch-safe animation fallback */
@media (hover: none) {
  .robot-card:hover {
    transform: none;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.04);
  }
}

/* === Keyframes: Accounts Scroll Fade Up === */
@keyframes accountFadeUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* === Shared Account Column Base === */
.account-column,
.ecn-column {
  background: #111;
  border: 1px solid #222;
  border-radius: 1.25rem;
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.05);
  text-align: left;
  max-width: 100%;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  font-family: 'Source Sans 3', sans-serif;
}

/* === Title Block === */
.account-column .title,
.ecn-column .title {
  font-family: 'Sulphur Point', sans-serif;
  font-size: 2.375rem;
  font-weight: 400;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* === Description Text === */
.account-column .description,
.ecn-column .description {
  font-size: 1.125rem;
  font-weight: 300;
  line-height: 1.875rem;
  color: #b0b0b0;
  margin-bottom: 2rem;
}

/* === CTA Button === */
.account-column .cta-button,
.ecn-column .cta-button {
  font-size: 1rem;
  font-weight: 600;
  padding: 0.875rem 1.75rem;
  border-radius: 30px;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s ease;
}

/* 🔵 Classic Button */
.account-column .cta-button {
  border: 2px solid #DB9CFF;
  color: #ffffff;
  background: transparent;
}

.account-column .cta-button:hover {
  background: linear-gradient(90deg, #B483F0 0%, #9CEBFF 100%);
  color: #11131a;
}

/* 🟡 ECN Button */
.ecn-column .cta-button {
  background: linear-gradient(90deg, #C48BFF 0%, #9CEBFF 100%);
  color: #11131a;
  border: none;
}

.ecn-column .cta-button:hover {
  opacity: 0.9;
}

/* === Desktop Hover Lift === */
@media (hover: hover) and (pointer: fine) {
  .account-column:hover,
  .ecn-column:hover {
    transform: translateY(-8px);
    box-shadow: 0 6px 20px rgba(255, 255, 0, 0.1);
  }
}

/* === Mobile Scroll-In Animation === */
@media (hover: none) {
  .account-column,
  .ecn-column {
    opacity: 0;
    transform: translateY(40px);
    animation: accountFadeUp 0.8s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }
}

/* === Responsive Layout Fixes === */
@media (max-width: 768px) {
  .account-column,
  .ecn-column {
    padding: 1.5rem;
  }

  .account-column .title,
  .ecn-column .title {
    font-size: 2rem;
    white-space: normal;
  }

  .account-column .description,
  .ecn-column .description {
    font-size: 1rem;
  }

  .account-column .cta-button,
  .ecn-column .cta-button {
    width: 100%;
    text-align: center;
  }
}

/* === Buttons Enhancement === */
.highlight-button {
  background: linear-gradient(90deg, #c48bff 0%, #9cebff 100%);
  color: #11131a !important;
  border: none !important;
  font-weight: 700;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.highlight-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2);
}

