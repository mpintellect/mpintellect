.justify-end { justify-content: flex-end; }

/* Grid System */
.grid { display: grid; }
.grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.md\:grid-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }
.md\:col-span-8 { grid-column: span 8 / span 8; }
