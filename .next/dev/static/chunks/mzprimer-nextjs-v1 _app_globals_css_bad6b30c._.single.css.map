}

/* 5. MODAL FOOTER */
.modal-footer {
  padding: 24px 30px 32px;
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* Button Refinement */
.confirm-purchase-btn {
  background: var(--gold-primary);
