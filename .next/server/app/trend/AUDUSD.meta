    "x-next-cache-tags": "_N_T_/layout,_N_T_/trend/layout,_N_T_/trend/[symbol]/layout,_N_T_/trend/[symbol]/page,_N_T_/trend/AUDUSD"
  },
  "segmentPaths": [
