}
/* === Footer Layout === */
.footer-one-line {
  background-color: #000;
  color: #b0b3b8;
  padding: 2rem 1rem;
}

.footer-content {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  border-bottom: 1px solid #222;
  padding-bottom: 2rem;
  text-align: center;
}

.footer-logo {
