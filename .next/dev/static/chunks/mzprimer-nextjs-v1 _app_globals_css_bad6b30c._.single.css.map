}

/* === INPUT BOX === */
.chatbot-input {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  margin-top: 1rem;
}

.symbol-select,
.capital-input {
  flex: 1;
  padding: 0.75rem 1rem;
  border-radius: 8px;
  border: 1px solid #444;
  background-color: #111;
  color: #fff;
  font-size: 0.95rem;
  outline: none;
}

.symbol-select option {
  background-color: #1f1f1f;
  color: #fff;
}

.submit-button,
.reset-button {
  background-color: #f5c000;
