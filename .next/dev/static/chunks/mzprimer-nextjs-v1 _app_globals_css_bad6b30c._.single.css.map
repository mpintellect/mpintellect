  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 10px;
  border: none;
  cursor: pointer;
}

/* 6. MOBILE REFINEMENT */
@media (max-width: 768px) {
  .modal-plans-grid {
    justify-content: flex-start; /* Enable scrolling */
