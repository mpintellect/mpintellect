  -webkit-background-clip: text;
  background-clip: text;
}

/* Prose Content Styling */
.prose {
  max-width: none;
  color: #d4d4d8;
}

.prose h2 {
  font-size: 1.875rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

.prose p {
  margin-bottom: 1rem;
}

/* SEO Chip Links */
.seo-chip-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 2rem;
  color: #ffffff;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(10px);
  position: relative;
  overflow: hidden;
}

.seo-chip-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.2), transparent);
  transition: left 0.5s ease;
}

.seo-chip-link:hover::before {
  left: 100%;
}

.seo-chip-link:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(168, 85, 247, 0.3);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px -5px rgba(168, 85, 247, 0.2);
}

/* RSI Meter Specific Styles */
.rsi-needle {
  animation: pulse-needle 2s ease-in-out infinite;
  transition: left 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.rsi-bubble {
  animation: float-bubble 3s ease-in-out infinite;
}

/* Responsive Design */
@media (max-width: 768px) {
  .text-4xl {
    font-size: 2rem;
    line-height: 1.2;
  }
  
  .text-6xl {
    font-size: 2.5rem;
    line-height: 1.2;
  }
  
  .glass-momentum-card {
    margin: 0 -1rem;
    border-radius: 1rem;
    border-left: none;
    border-right: none;
  }
  
  .prose {
    padding: 0 1rem;
  }
  
  .seo-chip-link {
    width: 100%;
    justify-content: center;
  }
  
  .grid-cols-2 {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .flex-col {
    gap: 1.5rem;
  }
  
  .text-lg {
    font-size: 1rem;
  }
  
  .h-8 {
    height: 1.5rem;
  }
  
  .-top-10 {
    top: -2rem;
  }
}

@media (max-width: 640px) {
  .px-6 {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  .pt-28 {
    padding-top: 5rem;
  }
  
  .p-8 {
    padding: 1.5rem;
  }
  
  .text-4xl {
    font-size: 1.75rem;
  }
  
  .w-14 {
    width: 3rem;
  }
  
  .h-14 {
    height: 3rem;
  }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #000000;
}

::-webkit-scrollbar-thumb {
  background: rgba(168, 85, 247, 0.3);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(168, 85, 247, 0.5);
}

/* Focus States for Accessibility */
button:focus-visible,
a:focus-visible,
.seo-chip-link:focus-visible {
  outline: 2px solid #a855f7;
  outline-offset: 2px;
}

/* Reduced Motion Support */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  
  .glass-momentum-card::before,
  .seo-chip-link::before {
    display: none;
  }
  
  .rsi-needle,
  .rsi-bubble {
    animation: none;
  }
  
  html {
    scroll-behavior: auto;
  }
}

/* High Contrast Mode Support */
@media (prefers-contrast: high) {
  .glass-momentum-card {
    background: #000000;
    border: 2px solid #a855f7;
  }
  
  .seo-chip-link {
    border: 2px solid #a855f7;
  }
}

/* Print Styles */
@media print {
  .glass-momentum-card {
    background: white;
    color: black;
    border: 1px solid #ccc;
  }
  
  .seo-chip-link {
    display: none;
  }
}
/* globales.css - Elegant Zones Analysis Styles */

/* Base Reset & Global Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

