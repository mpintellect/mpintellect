    "framer-motion": "^12.23.12",
    "gif-encoder-2": "^1.0.5",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "keccak": "^3.0.4",
    "lucide-react": "^0.536.0",
