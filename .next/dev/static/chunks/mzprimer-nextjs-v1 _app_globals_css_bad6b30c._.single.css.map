  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: #fff;
}

/* 2. THE CARD GRID (Desktop: Row | Mobile: Slider) */
.modal-plans-grid {
  display: flex;
  flex-direction: row;
  padding: 40px 20px;
  gap: 12px;
  justify-content: center; /* Desktop Center */
  
  /* Mobile Swipe Readiness */
