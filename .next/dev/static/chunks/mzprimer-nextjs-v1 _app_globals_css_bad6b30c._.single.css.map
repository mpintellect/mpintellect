    padding: 20px 10px !important;
  }

  /* 4. Shrift Scaling (Soft & Refined) */
  .modal-header h3 {
    font-size: 1rem !important;
    letter-spacing: 0.15em !important;
  }

  .plan-price {
    font-size: 1.3rem !important; /* Small elegant price */
    margin: 10px 0 !important;
  }

  .plan-header h4 {
    font-size: 9px !important;
    letter-spacing: 0.15em !important;
  }

  .setups-count {
    font-size: 8px !important;
  }

  /* 5. Compact Registration Form */
  .quick-register-form {
    padding: 0 10px 20px !important;
    gap: 1rem !important;
  }

  .form-group label {
    font-size: 9px !important;
    margin-bottom: 4px !important;
  }

  .form-group input {
    padding: 10px 12px !important;
    font-size: 14px !important; /* Prevents auto-zoom, stays sharp */
    border-radius: 8px !important;
  }

  /* 6. Button Shrinking */
  .btn-gold, .primary-btn, .select-plan-btn {
    padding: 10px 15px !important;
