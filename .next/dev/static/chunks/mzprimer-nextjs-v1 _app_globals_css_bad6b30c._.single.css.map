/* ===== Elegant Chat Message Styles for AI Assistant ===== */

/* Chat container body */
.chatbot-body {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  background: #000;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  scroll-behavior: smooth;
  background-image: 
    radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.05) 0%, transparent 20%),
    radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.05) 0%, transparent 20%);
}

/* Message wrapper */
.chat-msg {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  animation: fadeIn 0.4s ease-out;
}

.chat-msg.user {
  align-items: flex-end;
}

.chat-msg.ai {
  align-items: flex-start;
}

/* AI Response Bubble */
.chat-text {
  background: #1e293b;
  color: #e2e8f0;
  padding: 1rem 1.25rem;
  border-radius: 16px;
  max-width: 85%;
  line-height: 1.6;
  word-wrap: break-word;
  font-size: 0.95rem;
  border: 1px solid #334155;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

/* User Message Bubble */
.user-card {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  padding: 1rem 1.25rem;
  border-radius: 16px;
  max-width: 85%;
  font-size: 0.95rem;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

/* Typing indicator */
.chat-msg.ai:last-child {
  color: #94a3b8;
  font-style: italic;
  animation: pulse 2s infinite;
}

/* AI Analysis Card Block */
.ai-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 1.25rem 1.25rem 1rem;
  margin-bottom: 0.5rem;
  max-width: 100%;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(6px);
  transition: all 0.2s ease;
}

/* Section Title */
.section-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: #3b82f6;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  display: flex;
  gap: 0.5rem;
}

/* Section Content */
.section-content {
  color: #e2e8f0;
  font-size: 0.92rem;
  line-height: 1.6;
}

.section-content strong {
  color: #f8fafc;
  font-weight: 700;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}
/* ───────────────────────────────
   🔥 MZPrimer Global Client Styles
   Pages: Login, Register, Dashboard, Verify
──────────────────────────────── */

:root {
  --gold: #d4af37;
  --gold-soft: #f0d68a;
  --gold-dark: #a4841c;
  --blue: #3b82f6;
  --blue-dark: #1e3a8a;
  --card-dark: #111214;
  --card-mid: #18191c;
  --border: #2a2d31;
  --text-soft: #b5b7bd;
  --text-dim: #8d8f92;
  --page-bg: #0c0c0c;
}

/* Page wrapper */
.page-wrapper {
  min-height: 100vh;
  background: #000;
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem;
}

/* Card container */
.card-container {
  background: #111;
  border-radius: 1rem;
  padding: 2rem;
  width: 100%;
  max-width: 450px;
  box-shadow: 0 0 12px rgba(255, 255, 255, 0.05);
}

/* Section title */
.section-title {
  text-align: center;
  font-size: 1.8rem;
  font-weight: bold;
  color: #facc15;
  margin-bottom: 1rem;
}

/* Input field */
.input-field {
  width: 100%;
  padding: 0.75rem;
  background-color: #1f2937;
  color: #fff;
  border: none;
  border-radius: 0.5rem;
  font-size: 0.95rem;
  transition: box-shadow 0.2s ease;
}

.input-field:focus {
  outline: none;
  box-shadow: 0 0 0 2px #facc15;
}

/* Primary button */
.btn-primary {
  width: 100%;
  padding: 0.75rem;
  background-color: #facc15;
  color: #000;
  font-weight: 700;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.btn-primary:hover {
  background-color: #fcd34d;
}

.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Secondary button */
.btn-secondary {
  background-color: #374151;
  color: #fff;
  padding: 0.6rem 1rem;
  border-radius: 0.5rem;
  font-weight: 500;
  transition: background-color 0.2s ease;
}

.btn-secondary:hover {
  background-color: #4b5563;
}

/* CTA button */
.btn-cta {
  background-color: #22c55e;
  color: #000;
  font-weight: 700;
  padding: 0.6rem 1rem;
  border-radius: 0.5rem;
  transition: background-color 0.2s ease;
}

.btn-cta:hover {
  background-color: #4ade80;
}

/* Text link */
.text-link {
  color: #facc15;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.text-link:hover {
  text-decoration: underline;
  opacity: 0.9;
}

/* Grid actions */
.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  text-align: center;
}

/* Info banner */
.info-banner {
  background-color: #78350f;
  border: 1px solid #854d0e;
  color: #fde68a;
  padding: 0.75rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
}

/* Error alert */
.error-banner {
  background-color: #7f1d1d;
  border: 1px solid #991b1b;
  color: #fecaca;
  padding: 0.75rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
}

/* Setup Count Display */
.setup-counter {
  background-color: #1f2937;
  padding: 1rem;
  border-radius: 0.5rem;
  color: #facc15;
  font-weight: 700;
  font-size: 1.125rem;
}

/* Text styles */
.text-normal {
  color: #d1d5db;
  font-size: 1rem;
  margin-bottom: 1rem;
}

.text-small-muted {
  font-size: 0.75rem;
  color: #9ca3af;
  margin-top: 1rem;
}

.italic {
  font-style: italic;
}

/* Dashboard specific */
.dashboard-card {
  background: #111;
  border-radius: 1rem;
  padding: 2rem;
  max-width: 700px;
  width: 100%;
  box-shadow: 0 0 12px rgba(255, 255, 255, 0.05);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dashboard-welcome {
  font-size: 1.25rem;
  font-weight: bold;
}

.setup-box {
  background: #1f2937;
  padding: 1rem;
  border-radius: 0.5rem;
}

.setup-count {
  font-size: 1.25rem;
  font-weight: bold;
  color: #facc15;
}

.dashboard-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  text-align: center;
}

/* Button variants */
.btn-yellow {
  background: #facc15;
  color: #000;
  font-weight: bold;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: background 0.3s ease;
}

.btn-yellow:hover {
  background: #fde047;
}

.btn-gray {
  background: #374151;
  color: #fff;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: background 0.3s ease;
}

.btn-gray:hover {
  background: #4b5563;
}

.btn-green {
  background: #22c55e;
  color: #000;
  font-weight: bold;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: background 0.3s ease;
}

.btn-green:hover {
  background: #4ade80;
}

.referral-text {
  font-size: 0.875rem;
  color: #9ca3af;
  text-align: center;
  font-style: italic;
  margin-top: 1rem;
}


/* ─────────────────────────────────────────────────────────────
   🔐 AUTHENTICATION PAGES (Login & Register)
   Style: Premium Dark Glassmorphism
───────────────────────────────────────────────────────────── */

/* 1. Page Wrappers (Centering) */
.page-wrapper,
.register-page {
  min-height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 1rem;
  background: radial-gradient(circle at 50% 30%, #1a1a1a 0%, #000000 100%);
  position: relative;
}

/* Optional: Subtle background glow behind the card */
.page-wrapper::before,
.register-page::before {
  content: '';
  position: absolute;
  width: 300px;
  height: 300px;
  background: rgba(250, 204, 21, 0.05); /* Very subtle gold glow */
  filter: blur(100px);
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}

/* 2. The Auth Card (Container) */
.card-container,
.register-card {
  position: relative;
  z-index: 1;
  background: rgba(17, 17, 19, 0.95); /* Deep dark background */
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24px; /* Softer corners */
  padding: 3rem 2.5rem;
  width: 100%;
  max-width: 440px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 
              0 0 0 1px rgba(255, 255, 255, 0.02) inset; /* Inner rim light */
  backdrop-filter: blur(20px);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* Top Gold Line Highlight */
.card-container::after,
.register-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(250, 204, 21, 0.5), transparent);
}

/* 3. Titles */
.section-title,
.register-title {
  font-size: 2rem;
  font-weight: 800;
  text-align: center;
  margin-bottom: 1rem;
  color: #fff;
  letter-spacing: -0.5px;
  background: linear-gradient(to bottom right, #FACC15, #FFFFFF);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 4. Form Layouts */
.form-wrapper,
.register-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem; /* Spacing between inputs */
  width: 100%;
}

/* 5. Inputs */
.input-field,
.register-input {
  width: 100%;
  background-color: #0a0a0a;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 14px 16px;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 400;
  transition: all 0.2s ease;
  outline: none;
}

.input-field::placeholder,
.register-input::placeholder {
  color: #52525B; /* Text Dim */
}

.input-field:focus,
.register-input:focus {
  border-color: #FACC15;
  background-color: #0f0f0f;
  box-shadow: 0 0 0 4px rgba(250, 204, 21, 0.1);
}

.input-field:disabled,
.register-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* 6. Buttons */
.btn-primary,
.register-btn {
  width: 100%;
  padding: 14px;
  margin-top: 0.5rem;
  background: linear-gradient(180deg, #FACC15 0%, #EAB308 100%);
  color: #000000;
  font-size: 1rem;
  font-weight: 700;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 15px rgba(234, 179, 8, 0.2);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.btn-primary:hover,
.register-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(234, 179, 8, 0.3);
  filter: brightness(1.1);
}

.btn-primary:active,
.register-btn:active {
  transform: translateY(0);
}

.btn-primary:disabled,
.register-btn:disabled {
  background: #333;
  color: #666;
  cursor: not-allowed;
  box-shadow: none;
  transform: none;
}

/* 7. Error & Alert Banners */
.error-banner,
.error-box,
.alert-box {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  padding: 12px;
  border-radius: 10px;
  text-align: center;
  animation: shake 0.4s ease-in-out;
}

.error-banner,
.error-text,
.alert-text {
  color: #FCA5A5;
  font-size: 0.9rem;
  font-weight: 500;
  margin: 0;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  75% { transform: translateX(4px); }
}

/* 8. Footer Text & Links */
.small-muted,
.register-footer {
  text-align: center;
  color: #71717A;
  font-size: 0.9rem;
  margin-top: 1rem;
}

.text-link,
.register-link {
  color: #FACC15;
  font-weight: 600;
  text-decoration: none;
  transition: color 0.2s;
  margin-left: 4px;
}

.text-link:hover,
.register-link:hover {
  color: #FFF;
  text-decoration: underline;
}

/* 9. Mobile Optimization */
@media (max-width: 480px) {
  .card-container,
  .register-card {
    padding: 2rem 1.5rem;
    border-radius: 20px;
  }

  .section-title,
  .register-title {
    font-size: 1.75rem;
  }
}
/* Modal */
.modal-bg {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.modal-box {
  background: #111;
  border-radius: 1rem;
  padding: 2rem;
  width: 90%;
  max-width: 400px;
  box-shadow: 0 0 12px rgba(255, 255, 255, 0.1);
  color: white;
  text-align: center;
}

.modal-title {
  font-size: 1.25rem;
  font-weight: bold;
  color: #facc15;
  margin-bottom: 1rem;
}

.plan-options {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.plan-btn {
  background: #222;
  color: #fff;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  font-weight: 600;
  transition: all 0.2s ease;
  border: 2px solid transparent;
}

.plan-btn:hover {
  background: #333;
}

.plan-btn.selected {
  border-color: #facc15;
  background: #1e1e1e;
}

.modal-footer {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.confirm-btn {
  background: #22c55e;
  color: black;
  font-weight: bold;
  padding: 0.75rem;
  border-radius: 0.5rem;
}

.cancel-btn {
  background: #555;
  color: white;
  padding: 0.5rem;
  border-radius: 0.5rem;
}

/* Purchase options */
.purchase-options {
  margin-top: 2rem;
  padding: 1.5rem;
  background: #121212;
  border: 1px solid #2c2c2c;
  border-radius: 16px;
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.05);
}

.purchase-options-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #f5c84b;
  text-align: center;
  margin-bottom: 1.5rem;
  letter-spacing: 0.5px;
  text-shadow: 0 0 2px rgba(255, 215, 0, 0.3);
}

.purchase-btn {
  width: 100%;
  padding: 14px 20px;
  border-radius: 14px;
  font-weight: 600;
  font-size: 1rem;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.3s ease;
  background: linear-gradient(to right, #1e1e1e, #2a2a2a);
  color: #f0f0f0;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.08);
}

.purchase-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.purchase-btn + .purchase-btn {
  margin-top: 14px;
}

.plan-10 {
  border-left: 4px solid #facc15;
}

.plan-10:hover:not(:disabled) {
  background: linear-gradient(to right, #2a2a2a, #1f1f1f);
  box-shadow: 0 0 10px rgba(250, 204, 21, 0.3);
}

.plan-20 {
  border-left: 4px solid #f59e0b;
}

.plan-20:hover:not(:disabled) {
  background: linear-gradient(to right, #2e2e2e, #1a1a1a);
  box-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
}

.plan-30 {
  border-left: 4px solid #d97706;
}

.plan-30:hover:not(:disabled) {
  background: linear-gradient(to right, #292929, #181818);
  box-shadow: 0 0 10px rgba(217, 119, 6, 0.3);
}

/* Enhanced referral text */
.referral-text {
  margin-top: 1.5rem;
  font-size: 1rem;
  text-align: center;
  color: #e5c963;
  background: #1a1a1a;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid #333;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.06);
  transition: all 0.3s ease;
}

.referral-text strong {
  color: #f5d76e;
  font-weight: 600;
}

.referral-text .highlighted {
  background: linear-gradient(to right, #facc15, #f59e0b);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: bold;
}

/* Root Analytics Container */
.analytics-container {
  padding: 2rem;
  background: #0f0f0f;
  border-radius: 16px;
  margin: 2rem auto;
  max-width: 1400px;
  color: #f1f5f9;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.3);
}

.analytics-header {
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 2rem;
  color: #facc15;
  text-align: center;
  text-shadow: 1px 1px 3px #000;
}

/* Filters */
.analytics-filters {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 2rem;
}

.filter-select {
  background: #1e293b;
  border: 1px solid #334155;
  color: #f8fafc;
  padding: 0.5rem 1.25rem;
  border-radius: 10px;
  font-size: 0.95rem;
  transition: border-color 0.2s;
  min-width: 160px;
}

.filter-select:focus {
  outline: none;
  border-color: #facc15;
  background-color: #1c1c1c;
}

/* Metrics Grid */
.metrics-grid,
.profit-loss-grid,
.analytics-grid,
.stats-grid {
  display: grid;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.metrics-grid {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.profit-loss-grid {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.analytics-grid {
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
}

.stats-grid {
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

/* Metric Cards */
.metric-card,
.analytics-card,
.stats-card,
.highlight-card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 1.5rem;
  transition: all 0.2s ease;
  box-shadow: 0 0 10px rgba(8, 8, 8, 0.5);
}

.metric-card:hover,
.analytics-card:hover,
.stats-card:hover,
.highlight-card:hover {
  transform: translateY(-3px);
  border-color: #facc15;
}

.metric-value {
  font-size: 2.25rem;
  font-weight: 900;
  color: #facc15;
  margin-bottom: 0.5rem;
}

.metric-label {
  color: #cbd5e1;
  font-size: 0.95rem;
}

/* Profit/Loss Cards */
.profit-loss-card {
  padding: 1.5rem;
  border-radius: 12px;
  text-align: center;
  border: 1px solid;
  transition: all 0.2s ease;
}

.profit-loss-card:hover {
  transform: translateY(-3px);
}

.profit-loss-card.positive {
  background: rgba(16, 185, 129, 0.15);
  border-color: #10B981;
}

.profit-loss-card.negative {
  background: rgba(239, 68, 68, 0.15);
  border-color: #EF4444;
}

.profit-loss-card.neutral {
  background: rgba(156, 163, 175, 0.15);
  border-color: #9CA3AF;
}

.pl-value {
  font-size: 1.75rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.pl-label {
  color: #94a3b8;
  font-size: 0.95rem;
}

.profit-loss-card.positive .pl-value {
  color: #10B981;
}

.profit-loss-card.negative .pl-value {
  color: #EF4444;
}

.profit-loss-card.neutral .pl-value {
  color: #9CA3AF;
}

/* Trading Style Section */
.trading-style-card {
  background: #1f2937;
  padding: 1.75rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  border-left: 5px solid #facc15;
  box-shadow: inset 0 0 5px #00000080;
}

.style-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.style-type {
  font-size: 1.4rem;
  font-weight: 700;
  color: #facc15;
}

.style-confidence {
  background: #064e3b;
  color: #34d399;
  padding: 0.3rem 0.9rem;
  border-radius: 9999px;
  font-size: 0.8rem;
  font-weight: 600;
}

.style-description {
  color: #d1d5db;
  margin-bottom: 1rem;
  line-height: 1.6;
}

.style-characteristics {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.characteristic-tag {
  background: #334155;
  color: #e2e8f0;
  padding: 0.25rem 0.8rem;
  border-radius: 9999px;
  font-size: 0.8rem;
}

/* Analytics Charts */
.analytics-card h4 {
  color: #f1f5f9;
  margin-bottom: 1rem;
  font-size: 1.15rem;
  font-weight: 600;
  text-align: center;
}

/* Stats Cards */
.stats-card h5,
.highlight-card h5 {
  color: #f3f4f6;
  margin-bottom: 1rem;
  font-size: 1.05rem;
  border-bottom: 1px solid #374151;
  padding-bottom: 0.5rem;
}

.stats-list,
.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.stat-item,
.highlight-item {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #374151;
  font-size: 0.95rem;
}

.stat-item:last-child,
.highlight-item:last-child {
  border-bottom: none;
}

.stat-item span:first-child,
.highlight-item span:first-child {
  color: #9ca3af;
}

.stat-item span:last-child,
.highlight-item span:last-child {
  color: #f1f5f9;
  font-weight: 600;
}

/* Loading / No Data / Errors */
.analytics-loading,
.no-data,
.error-message {
  text-align: center;
  padding: 2.5rem;
  color: #94a3b8;
  font-size: 1.1rem;
}

.error-message {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border-radius: 10px;
  border: 1px solid #ef4444;
}

/* Responsive */
@media (max-width: 768px) {
  .analytics-container {
    padding: 1.25rem;
  }

  .metrics-grid,
  .profit-loss-grid,
  .analytics-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .analytics-filters {
    flex-direction: column;
    align-items: stretch;
  }

  .style-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}
@media (max-width: 768px) {
  .analytics-container {
    padding: 1rem;
  }

  .analytics-header {
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }

  .filter-select {
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    min-width: 130px;
  }

  .metrics-grid,
  .profit-loss-grid,
  .analytics-grid,
  .stats-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .metric-value {
    font-size: 1.5rem;
  }

  .metric-label,
  .pl-label,
  .stat-item span,
  .highlight-item span {
    font-size: 0.85rem;
  }

  .pl-value {
    font-size: 1.4rem;
  }

  .style-type {
    font-size: 1.1rem;
  }

  .style-confidence {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
  }

  .style-description {
    font-size: 0.9rem;
  }

  .characteristic-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
  }

  .analytics-card h4,
  .stats-card h5,
  .highlight-card h5 {
    font-size: 0.95rem;
  }

  .analytics-loading,
  .no-data,
  .error-message {
    font-size: 1rem;
    padding: 2rem;
  }
}

@media (max-width: 480px) {
  .analytics-header {
    font-size: 1.2rem;
  }

  .metric-value {
    font-size: 1.3rem;
  }

  .pl-value {
    font-size: 1.25rem;
  }

  .filter-select {
    font-size: 0.75rem;
    padding: 0.35rem 0.7rem;
  }

  .analytics-container {
    padding: 0.75rem;
  }

  .style-type {
    font-size: 1rem;
  }

  .style-description {
    font-size: 0.85rem;
  }

  .analytics-card,
  .stats-card,
  .metric-card,
  .highlight-card {
    padding: 1rem;
  }

  .stat-item span,
  .highlight-item span {
    font-size: 0.8rem;
  }
}
/* ──────── ANALYTICS DASHBOARD ──────── */

.analytics-container {
  max-width: 1400px;
  margin: 2rem auto;
  padding: 2.5rem;
}

/* Filters */
.analytics-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2rem;
  justify-content: center;
}

/* Metric Cards Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.metric-card {
  background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%);
  border: 1px solid rgba(59, 130, 246, 0.2);
  border-radius: 16px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s;
  position: relative;
  overflow: hidden;
}

.metric-card:hover {
  transform: translateY(-3px);
  border-color: var(--blue);
  box-shadow: var(--glow-blue);
}

.metric-value {
  font-size: 2.2rem;
  font-weight: 800;
  color: #fff;
  margin: 0.5rem 0;
}

.metric-label {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
  margin-top: auto;
}

/* Profit Loss Grid */
.profit-loss-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.5rem;
}

.profit-loss-card {
  background: #111;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.5rem;
  text-align: center;
  transition: transform 0.2s;
}

.profit-loss-card:hover { 
  transform: translateY(-2px); 
}

.profit-loss-card.positive {
  border-color: rgba(16, 185, 129, 0.3);
  background: linear-gradient(145deg, rgba(16, 185, 129, 0.05), transparent);
  box-shadow: 0 0 15px rgba(16, 185, 129, 0.1);
}

.profit-loss-card.negative {
  border-color: rgba(239, 68, 68, 0.3);
  background: linear-gradient(145deg, rgba(239, 68, 68, 0.05), transparent);
  box-shadow: 0 0 15px rgba(239, 68, 68, 0.1);
}

.pl-value {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.positive .pl-value { color: var(--green); }
.negative .pl-value { color: var(--red); }

.pl-label { 
  font-size: 0.85rem; 
  color: var(--text-muted); 
}

/* Trading Style Card */
.trading-style-card {
  background: #161618;
  padding: 2rem;
  border-radius: 16px;
  border-left: 4px solid var(--gold);
  margin-top: 2rem;
  box-shadow: var(--shadow-card);
}

.style-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.style-type { 
  font-size: 1.5rem; 
  color: var(--gold); 
  font-weight: 700; 
}

.style-confidence {
  background: rgba(16, 185, 129, 0.15);
  color: var(--green);
  padding: 0.3rem 0.8rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.style-characteristics {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem;
}

.characteristic-tag {
  background: #27272a;
  color: #e5e7eb;
  padding: 0.3rem 0.8rem;
  border-radius: 6px;
  font-size: 0.85rem;
  border: 1px solid var(--border);
}
/* ──────── CHATBOX (THE CORE) ──────── */

.chatbox-wrapper {
  background: rgba(17, 17, 19, 0.95); /* High-end glass feel */
  backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  overflow: visible !important; 
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  transition: all 0.3s ease;
}

/* Popup Mode Positioning */
.chatbox-wrapper.popup {
  position: fixed;
  right: 30px;
  bottom: 30px;
  width: 420px;
  max-height: 85vh;
  z-index: 3000;
}

/* Section Mode Positioning */
.chatbox-wrapper.section {
  width: 100%;
  max-width: 900px;
  margin: 2rem auto;
  height: 700px; /* Fixed height for dashboard view */
}

/* Header */
.chatbox-header {
  background: rgba(255, 255, 255, 0.02);
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: var(--gold);
}

.chatbox-close {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 1.2rem;
  cursor: pointer;
  transition: color 0.2s;
}
.chatbox-close:hover { color: #fff; }

/* Message Area */
.chatbox-body {
  flex: 1;
  padding: 1.5rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  background: radial-gradient(circle at center, rgba(20, 20, 25, 0.5), rgba(0, 0, 0, 0.8));
}

/* Message Animation */
.chat-msg {
  margin-bottom: 0.5rem;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* User Message Bubble */
.user-bubble {
  align-self: flex-end;
  background: linear-gradient(135deg, var(--blue), var(--blue-hover));
  color: white;
  padding: 0.8rem 1.2rem;
  border-radius: 14px 14px 0 14px;
  max-width: 80%;
  font-size: 0.95rem;
  box-shadow: 0 2px 10px rgba(59, 130, 246, 0.2);
  line-height: 1.5;
  float: right;
  clear: both;
}

/* AI Message Bubble */
.ai-bubble {
  align-self: flex-start;
  background: #1f2937;
  border: 1px solid var(--border);
  color: #e5e7eb;
  padding: 0.8rem 1.2rem;
  border-radius: 14px 14px 14px 0;
  max-width: 85%;
  font-size: 0.95rem;
  line-height: 1.5;
  float: left;
  clear: both;
}

/* Rich AI Card (Trade Setups) */
.ai-card {
  background: #131315;
  border: 1px solid #27272a;
  border-left: 3px solid var(--gold);
  border-radius: 8px;
  padding: 1.25rem;
  margin-bottom: 0.5rem;
  width: 100%;
  float: left;
  clear: both;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.ai-card-title {
  color: var(--gold);
  font-size: 0.85rem;
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 0.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 0.5rem;
  letter-spacing: 0.5px;
}

.ai-card-content {
  color: #d4d4d8;
  font-size: 0.95rem;
  line-height: 1.6;
}

/* Signal Status Colors (used inside AI cards) */
.buy { color: var(--green); font-weight: 700; }
.sell { color: var(--red); font-weight: 700; }
.wait { color: #F59E0B; font-weight: 700; }

/* Input Area */


.chatbox-input, .chatbox-select {
  flex: 1;
  background-color: #0a0a0a !important;
  color: white !important;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  font-size: 0.95rem;
  outline: none;
  transition: border-color 0.2s;
}

.chatbox-input:focus, .chatbox-select:focus {
  border-color: var(--blue);
}

/* Action Buttons */
.chatbox-submit {
  background: var(--blue);
  color: white;
  border: none;
  padding: 0 20px;
  border-radius: 8px;
  font-weight: 600;
  height: 45px;
  cursor: pointer;
  transition: background 0.2s;
}
.chatbox-submit:hover { background: var(--blue-hover); }

.chatbox-reset {
  background: #27272a;
  color: #aaa;
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.chatbox-reset:hover { color: white; background: #333; }

/* Mobile Optimization for Chat */
@media (max-width: 768px) {
  .chatbox-wrapper.popup {
    position: fixed;
    top: auto;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 80vh;
    max-height: 80vh;
    border-radius: 16px 16px 0 0;
    border-bottom: none;
  }
}

/* =============================== */
/*   ELEGANT TOP COOKIE STRIP      */
/* =============================== */

@keyframes slideDownFade {
  from { transform: translateY(-100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.cookie-strip-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 1000; /* Higher than Navbar */
  
  /* Slide Down Animation */
  animation: slideDownFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.cookie-strip-inner {
  /* Thin Glass Bar Look */
  background: rgba(5, 5, 5, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  
  /* Subtle Gold Bottom Border */
  border-bottom: 1px solid rgba(234, 179, 8, 0.3);
  
  /* Flex Layout: Compact and Side-by-Side */
  display: flex;
  align-items: center;
  justify-content: center; /* Center content on wide screens */
  gap: 1.5rem;
  
  /* Minimal Height (Altitude) */
  padding: 0.5rem 1rem; /* 8px top/bottom padding */
  width: 100%;
}

/* On Mobile, allow stacking but keep tight */
@media (max-width: 768px) {
  .cookie-strip-inner {
    flex-direction: column;
    padding: 0rem 5rem;
    gap: 0rem ;
    text-align: center;
  }
}

.cookie-text-group {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  max-width: 50rem;
}

.cookie-text {
  font-size: 0.75rem; /* Small, readable */
  color: #d4d4d8; /* Zinc-300 */
  line-height: 1.3;
}

.cookie-icon-wrapper {
  color: #eab308; /* Yellow-500 */
  display: flex;
  align-items: center;
}

/* Buttons Container */
.cookie-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0rem 2rem;
  flex-shrink: 0; /* Prevents buttons from squishing */
}

/* Minimalist Button (Decline) */
.btn-cookie-link {
  font-size: 0.75rem;
  color: #71717a; /* Zinc-500 */
  background: none;
  border: none;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s;
  padding: 3px 4px;
  white-space: nowrap;
}

.btn-cookie-link:hover {
  color: white;
}

/* Compact Accept Button (Gold) */
.btn-cookie-accept-sm {
  background: linear-gradient(to right, #eab308, #b45309);
  color: white;
  font-weight: 600;
  font-size: 0.75rem;
  padding: 0.35rem 1rem; /* Very compact padding */
  border-radius: 9999px; /* Pill shape */
  display: flex;
  align-items: center;
  gap: 0.4rem;
  box-shadow: 0 4px 10px rgba(234, 179, 8, 0.15);
  transition: transform 0.2s, filter 0.2s;
  white-space: nowrap;
}

.btn-cookie-accept-sm:hover {
  transform: translateY(-1px);
  filter: brightness(110%);
}

@media (min-width: 769px) {
  .cookie-strip-container {
    margin-top: 60px; /* Adjust this value based on your navbar height */
  }
}

/* ========================================== */
/*    ADMIN DASHBOARD (Tactical / Command)    */
/* ========================================== */

.admin-bg-pattern {
  background-color: #000;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 40px 40px; /* Grid Pattern */
}

.admin-card-container {
  border: 1px solid #27272a; /* zinc-800 */
  background-color: #09090b; /* zinc-950 */
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 1), 0 20px 60px -20px rgba(0, 0, 0, 0.7);
}

.admin-title {
  font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.admin-badge-online {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 99px;
  font-size: 0.7rem;
  font-weight: 700;
  background: rgba(22, 163, 74, 0.1);
  border: 1px solid rgba(22, 163, 74, 0.3);
  color: #4ade80; /* green-400 */
  font-family: monospace;
}

.admin-input {
  background-color: #18181b; /* zinc-900 */
  border: 1px solid #3f3f46; /* zinc-700 */
  color: white;
  transition: all 0.2s ease;
  width: 100%;
  padding: 0.75rem;
  border-radius: 8px;
}

.admin-input:focus {
  border-color: #eab308; /* Yellow */
  box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.1);
  outline: none;
}

/* TABS SYSTEM */
.admin-tab-active-ai {
  background: rgba(234, 179, 8, 0.08); /* yellow tint */
  color: #facc15; /* yellow-400 */
  border-bottom: 2px solid #facc15;
}

.admin-tab-active-manual {
  background: rgba(168, 85, 247, 0.08); /* purple tint */
  color: #c084fc; /* purple-400 */
  border-bottom: 2px solid #c084fc;
}

/* AI PREVIEW BOX */
.admin-preview-box {
  position: relative;
  background-color: #000;
  border: 1px solid #3f3f46;
  padding: 1rem;
  border-radius: 0.75rem;
  overflow: hidden;
}

.admin-preview-line {
  width: 4px;
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: #facc15; /* Yellow bar */
}

.admin-log-box {
  font-family: monospace;
  font-size: 0.8rem;
  padding: 1rem;
  border-radius: 0.5rem;
  margin-top: 1rem;
  text-align: center;
  border: 1px dashed rgba(255,255,255,0.2);
}
.admin-log-success {
  background: rgba(22, 163, 74, 0.1);
  color: #4ade80;
  border-color: #22c55e;
}
.admin-log-error {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
  border-color: #ef4444;
}

/* BUTTONS */
.btn-broadcast-test {
  border: 1px solid #27272a;
  background: rgba(39, 39, 42, 0.4);
  transition: all 0.2s;
}
.btn-broadcast-test:hover { border-color: #52525b; background: rgba(39, 39, 42, 0.8); }
.btn-broadcast-test.selected { border-color: #3b82f6; background: rgba(59, 130, 246, 0.1); color: #60a5fa; }

.btn-broadcast-all {
  border: 1px solid #27272a;
  background: rgba(39, 39, 42, 0.4);
  transition: all 0.2s;
}
.btn-broadcast-all:hover { border-color: #52525b; background: rgba(39, 39, 42, 0.8); }
.btn-broadcast-all.selected { border-color: #ef4444; background: rgba(239, 68, 68, 0.1); color: #f87171; }


/* ================================================= */
/*   PREMIUM MICRO-ALERT & DESKTOP NOTIFICATION      */
/* ================================================= */

:root {
  --obsidian: #050505;
  --matte-black: #0d0d0d;
  --gold-metallic: #d4af37;
  --gold-soft: #f1d592;
  --gold-border: rgba(212, 175, 55, 0.15);
  --text-silk: #f8fafc;
  --text-dim: #64748b;
  --emerald-lux: #10b981;
  --ruby-lux: #ef4444;
}

/* 1. ANIMATIONS */
@keyframes microZoom {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes popupEntrance {
  0% { opacity: 0; transform: translateY(60px) scale(0.96); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes goldShimmer {
  0% { background-position: 200% center; }
  100% { background-position: -200% center; }
}

@keyframes pulseDot {
  0% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
  70% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 5px rgba(34, 197, 94, 0); }
  100% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
}

/* 2. CONTAINER LOGIC (MOBILE DEFAULT: CENTERED) */
.popup-container {
  position: fixed;
  inset: 0; /* Cover screen for centering */
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6); /* Dim background */
  backdrop-filter: blur(4px);
  padding: 16px;
}

/* 3. CARD LOGIC (MOBILE DEFAULT: MICRO-CARD) */
.popup-card {
  width: 100%;
  max-width: 250px; /* Ultra small width */
  background: var(--obsidian);
  border: 1px solid var(--gold-border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
  animation: microZoom 0.3s ease-out;
  position: relative;
}

/* 4. HEADER (MOBILE: TIGHT) */
.popup-header {
  padding: 6px 12px;
  background: var(--matte-black);
  border-bottom: 1px solid var(--gold-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.popup-header-title {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--text-dim);
  text-transform: uppercase;
}

.live-dot {
  width: 4px;
  height: 4px;
  background-color: var(--emerald-lux);
  border-radius: 50%;
  animation: pulseDot 2s infinite;
  margin-right: 4px;
}

/* 5. BODY & CONTENT (MOBILE: CONDENSED) */
.popup-body {
  padding: 12px 16px;
  text-align: center;
}

.popup-symbol-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.popup-symbol {
  color: white;
  font-size: 18px;
  font-weight: 900;
  letter-spacing: -0.02em;
}

.popup-badge {
  font-size: 9px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 4px;
  text-transform: uppercase;
}

/* Labels: HIDDEN ON MOBILE to save height */
.popup-label {
  display: none; 
}

/* Stats Layout */
.grid.grid-cols-2 {
  gap: 8px !important;
  margin-bottom: 12px !important;
  margin-top: 4px !important;
}

.effect-price-glow {
  color: #ffffff;
  font-weight: 700;
  font-family: monospace;
  font-size: 14px;
  padding: 2px 6px;
  background: rgba(255,255,255,0.05);
  border-radius: 4px;
  border-left: 2px solid #2563eb;
  text-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
}

.effect-confidence-score {
  background: linear-gradient(90deg, #ca8a04, #fcd34d, #ffffff, #fcd34d, #ca8a04);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-weight: 900;
  font-size: 1.4rem;
  animation: goldShimmer 3s linear infinite;
}

/* 6. CTA BUTTON (MOBILE: COMPACT) */
.btn-popup-cta {
  width: 100%;
  background: linear-gradient(135deg, #2563eb, #4f46e5); 
  color: white;
  font-size: 11px;
  font-weight: 700;
  padding: 8px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
}

/* 7. DESKTOP OVERRIDE (ORIGINAL STYLE) */
@media (min-width: 768px) {
  .popup-container {
    inset: auto;
    bottom: 2rem;
    right: 2rem;
    background: transparent;
    backdrop-filter: none;
    display: block;
    width: auto;
    max-width: 24rem;
    animation: popupEntrance 0.7s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }

  .popup-card {
    max-width: 24rem;
    border-radius: 14px;
    background: radial-gradient(circle at top right, #18181b, #09090b);
  }

  .popup-header {
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.4);
  }

  .popup-header-title {
    font-size: 0.7rem;
    color: #e4e4e7;
  }

  .popup-body {
    padding: 1.25rem 1.5rem;
    text-align: left;
  }

  .popup-symbol-row {
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .popup-symbol {
    font-size: 1.4rem;
  }

  .popup-label {
    display: flex; /* Restore for desktop */
    color: #a1a1aa;
    font-size: 0.65rem;
    margin-bottom: 0.25rem;
  }

  .effect-price-glow {
    font-size: 1.15rem;
  }

  .effect-confidence-score {
    font-size: 1.8rem;
  }

  .btn-popup-cta {
    font-size: 0.9rem;
    padding: 0.9rem;
  }

  .popup-badge {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 6px;
  }
}

/* SHARED BADGE COLORS */
.popup-badge-buy {
  background: rgba(16, 185, 129, 0.2);
  border: 1px solid rgba(16, 185, 129, 0.6);
  color: #34d399;
}

.popup-badge-sell {
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid rgba(239, 68, 68, 0.6);
  color: #f87171;
}

.btn-popup-close {
  color: #71717a;
  background: transparent;
  border: none;
  cursor: pointer;
}

/* ==========================================
   📱 IOS GUIDE OVERLAY
   ========================================== */
.ios-guide-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.4s ease-out;
}

.ios-guide-card {
  width: 100%;
  max-width: 340px;
  background: var(--obsidian);
  border: 1px solid var(--gold-border);
  border-radius: 32px;
  position: relative;
  box-shadow: 0 0 40px rgba(212, 175, 55, 0.1);
}

.ios-pwa-box {
  background: var(--matte-black);
  border-radius: 20px;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.ios-step-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 12px 0;
  font-size: 13px;
  color: var(--text-silk);
}

.ios-icon-circle {
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-telegram {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 14px;
  background: #0088cc;
  color: white;
  border-radius: 14px;
  font-weight: 700;
  text-decoration: none;
}

/* POINTERS */
.ios-pointer-container {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--gold-soft);
  z-index: 10001;
}

.ios-pos-chrome { top: 20px; right: 20px; }
.ios-pos-safari { bottom: 20px; left: 50%; transform: translateX(-50%); }

.arrow-animated {
  animation: bounceArrow 1.5s infinite;
}

.arrow-label-capsule {
  background: var(--gold-metallic);
  color: var(--obsidian);
  padding: 6px 14px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 900;
  text-transform: uppercase;
}

/* ANIMATIONS */
@keyframes slideUpFade {
  from { opacity: 0; transform: translateY(40px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

@keyframes bounceArrow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* ============================================================= */
/*    IOS OVERLAY SYSTEM (Menu + Guides)                         */
/* ============================================================= */

/* 1. Full Screen Dimmer */
.ios-guide-overlay {
  position: fixed !important;
  inset: 0; /* Top/Left/Right/Bottom 0 */
  width: 100vw;
  height: 100dvh; /* Full device height */
  z-index: 2147483647; /* Top Layer */
  
  background: rgba(5, 5, 5, 0.92); /* Pure Focus Black */
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1.5rem;
  
  animation: fadeInBlur 0.4s ease-out forwards;
}

/* 2. The Instruction/Menu Card */
.ios-guide-card {
  width: 100%;
  max-width: 22rem;
  background: #18181b;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-top: 1px solid rgba(234, 179, 8, 0.6); /* Gold Highlight */
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 1);
  transform: translateY(-10vh); /* Visually centers better */
}

/* Instruction Steps Styling */
.ios-pwa-box {
  background: rgba(255,255,255,0.04);
  border-radius: 16px;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  border: 1px solid rgba(255,255,255,0.05);
}

.ios-step-row {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.85rem;
  color: #d4d4d8;
}

.ios-icon-circle {
  width: 32px; height: 32px;
  background: rgba(255,255,255,0.08);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
}

/* --- BUTTONS FOR IOS MENU --- */

/* Apple Wallet */
.btn-apple-wallet {
  background: #000;
  color: white;
  padding: 14px;
  font-size: 0.9rem; font-weight: 600;
  border: 1px solid #333;
  border-radius: 14px;
  display: flex; justify-content: center; align-items: center; gap: 8px;
  position: relative; overflow: hidden;
  transition: transform 0.2s;
}
.btn-apple-wallet::after {
  content: ""; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transform: skewX(-25deg); animation: liquidGold 4s infinite;
}

/* Telegram */
.btn-telegram {
  background: #229ED9;
  color: white;
  padding: 14px;
  border-radius: 14px;
  font-weight: 600; font-size: 0.9rem;
  border: none;
  display: flex; justify-content: center; align-items: center; gap: 8px;
  margin-top: 10px;
  transition: opacity 0.2s;
}
.btn-telegram:active { opacity: 0.8; }


/* ============================================================= */
/*    3. INTELLIGENT POINTERS (SAFARI vs CHROME)                 */
/* ============================================================= */

/* Base Container */
.ios-pointer-container {
  position: absolute;
  z-index: 2147483647;
  pointer-events: auto;
}

.arrow-label-capsule {
  background: rgba(16, 16, 20, 0.95);
  border: 1px solid rgba(234, 179, 8, 0.4);
  color: #facc15; /* Gold */
  font-size: 0.65rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.1em;
  padding: 8px 14px;
  border-radius: 99px;
  box-shadow: 0 0 20px rgba(234, 179, 8, 0.2);
  white-space: nowrap;
  margin-bottom: 6px;
}

.arrow-animated {
  color: #eab308;
  filter: drop-shadow(0 0 8px rgba(234, 179, 8, 0.6));
}

/* --- CONFIG A: SAFARI (Bottom Right) --- */
.ios-pos-safari {
  bottom: 12px;
  right: 16px; /* Perfect spacing for iOS */
  padding-bottom: env(safe-area-inset-bottom);
  
  display: flex;
  flex-direction: column;
  align-items: flex-end; /* Align text bubble right */
}

.arrow-safari {
  width: 42px; height: 42px;
  animation: arrowBounceSmooth 1.5s infinite;
}

/* --- CONFIG B: CHROME (Top Right) --- */
.ios-pos-chrome {
  top: 16px;
  right: 16px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

/* Chrome arrow needs to flip */
.ios-pos-chrome .arrow-label-capsule {
  order: 2; /* Text below arrow */
  margin-top: 6px;
}
.arrow-chrome {
  order: 1;
  width: 42px; height: 42px;
  transform: rotate(180deg);
  animation: arrowBounceSmooth 1.5s infinite reverse;
}
/* ================================================== */
/*   REFERRAL & REWARDS HUB STYLES                    */
/* ================================================== */

.referral-container {
  max-width: 56rem;
  margin: 0 auto;
  padding: 1.5rem;
  color: white;
}

/* HEADER SECTION */
.referral-header {
  text-align: center;
  margin-bottom: 3rem;
}

.referral-title {
  font-size: 1.875rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
}

.referral-subtitle {
  color: #a1a1aa; /* zinc-400 */
  font-size: 1rem;
}

/* 1. UNIQUE LINK CARD (The Hero) */
.referral-hero-card {
  background: #09090b; /* zinc-950 */
  border: 1px solid #27272a; /* zinc-800 */
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
  text-align: center;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

.referral-hero-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(to right, #ca8a04, #eab308); /* Gold Gradient Top */
}

.referral-hero-label {
  font-weight: 600;
  color: white;
  font-size: 1.125rem;
  margin-bottom: 1.5rem;
}

.referral-link-box {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
  max-width: 36rem;
  margin: 0 auto;
}

/* Desktop alignment for link box */
@media (min-width: 768px) {
  .referral-link-box {
    flex-direction: row;
  }
}

.referral-input-readonly {
  width: 100%;
  background-color: #000;
  border: 1px solid #3f3f46; /* zinc-700 */
  color: #d4d4d8;
  padding: 1rem;
  border-radius: 0.75rem;
  font-family: monospace;
  font-size: 0.875rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-referral-copy {
  background: linear-gradient(135deg, #ca8a04 0%, #eab308 100%);
  color: black;
  font-weight: 700;
  border: none;
  border-radius: 0.75rem;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
  width: 100%;
}
.btn-referral-copy:hover { filter: brightness(110%); transform: translateY(-1px); }

.btn-referral-share {
  background-color: #27272a; /* zinc-800 */
  color: white;
  font-weight: 700;
  border: none;
  border-radius: 0.75rem;
  padding: 1rem;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-referral-share:hover { background-color: #3f3f46; }

/* 2. STATS GRID */
.referral-stats-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
@media (min-width: 768px) {
  .referral-stats-grid { grid-template-columns: 1fr 1fr; }
}

.stat-card {
  background: #18181b; /* zinc-900 */
  border: 1px solid #27272a;
  border-radius: 1rem;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.2s;
}
.stat-card:hover { border-color: #3f3f46; }

.stat-label {
  font-size: 0.75rem;
  color: #71717a; /* zinc-500 */
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin-bottom: 0.25rem;
}

.stat-value {
  font-size: 2.25rem;
  font-weight: 900;
  color: white;
}
.stat-value.highlight { color: #4ade80; /* green */ }

.stat-icon-circle {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-blue { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.icon-green { background: rgba(74, 222, 128, 0.15); color: #4ade80; }

/* 3. REDEEM SECTION */
.referral-redeem-card {
  background: rgba(24, 24, 27, 0.6); /* Transparent Zinc */
  border: 1px dashed #3f3f46;
  border-radius: 0.75rem;
  padding: 1.5rem;
}

.redeem-title {
  color: #9ca3af; /* zinc-400 */
  font-weight: 500;
  margin-bottom: 1rem;
  font-size: 0.875rem;
}

.redeem-form {
  display: flex;
  gap: 0.75rem;
}

.referral-input-field {
  flex: 1;
  background: #000;
  border: 1px solid #3f3f46;
  color: white;
  border-radius: 0.5rem;
  padding: 0.5rem 1rem;
  font-family: monospace;
  transition: border-color 0.2s;
}
.referral-input-field:focus {
  border-color: #eab308;
  outline: none;
}

.btn-redeem {
  background: #3f3f46;
  color: white;
  border: none;
  border-radius: 0.5rem;
  padding: 0.5rem 1.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-redeem:hover { background: #52525b; }
.btn-redeem:disabled { opacity: 0.5; cursor: not-allowed; }
/* --- 4. NAVIGATION / BACK BUTTON --- */
.referral-back-wrapper {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 10;
}

/* On Desktop, align with the main container content */
@media (min-width: 768px) {
  .referral-back-wrapper {
    top: 2rem;
    left: 0; 
  }
}

.btn-referral-back {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  
  background: transparent;
  border: 1px solid transparent;
  color: #a1a1aa; /* zinc-400 */
  
  padding: 0.5rem 0.85rem;
  border-radius: 0.5rem;
  
  font-size: 0.875rem; /* 14px */
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-referral-back:hover {
  color: white;
  background-color: #18181b; /* zinc-900 */
  border-color: #27272a; /* zinc-800 */
  transform: translateX(-2px);
}

/* Mobile Text Visibility Helper */
.back-text {
  display: none;
}
@media (min-width: 640px) {
  .back-text { display: inline; }
}
/* ============================================================ */
/*   FLOATING NOTIFICATION BUTTON (Bottom Right Persist)        */
/* ============================================================ */

.floating-notify-wrapper {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 8000; /* High, but below the Full Screen Overlay (9999+) */
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
}

/* The Button Itself */
.btn-float-bell {
  background: linear-gradient(135deg, #000000 0%, #1c1c1c 100%);
  border: 0px solid rgba(234, 179, 8, 0.4); /* Gold border */
  color: white;
  
  padding: 1px 0.2px;
  border-radius: 9px; /* Pill shape */
  
  font-family: system-ui, sans-serif;
  font-weight: 0;
  font-size: 0rem;
  
  display: flex;
  align-items: center;
  gap: 10px;
  
  box-shadow: 0 8px 20px -5px rgba(0,0,0,0.7), 0 0 0 1px rgba(234, 179, 8, 0.1);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  cursor: pointer;
}

/* Gold Icon Wrapper */
.float-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #facc15; /* Yellow-400 */
}

/* Hover State */
.btn-float-bell:hover {
  transform: translateY(-4px) scale(1.02);
  border-color: #facc15;
  box-shadow: 0 12px 30px -8px rgba(234, 179, 8, 0.3);
}

/* Active/Subscribed State (Green) */
.btn-float-active {
  background: rgba(6, 78, 59, 0.8); /* Green Tint */
  border-color: rgba(34, 197, 94, 0.5);
  color: #4ade80;
  box-shadow: none;
  cursor: default;
}

/* Attention Animation (Pulse if not subscribed) */
@keyframes bellShake {
  0% { transform: rotate(0); }
  15% { transform: rotate(15deg); }
  30% { transform: rotate(-15deg); }
  45% { transform: rotate(10deg); }
  60% { transform: rotate(-10deg); }
  100% { transform: rotate(0); }
}

.animate-bell-shiver:hover .float-icon-box {
  animation: bellShake 0.8s ease;
}

/* Hide on very small screens if needed, or adjust */
@media (max-width: 400px) {
  .btn-float-bell span {
    display: none; /* Hide text on tiny screens, show icon only */
  }
  .btn-float-bell {
    padding: 12px;
    border-radius: 50%;
  }
}
/* ========================================= */
/*   LIVE FEED CARD STATS (Fix for Desktop)  */
/* ========================================= */

.card-stats-grid {
  display: grid;
  /* Mobile: 2 columns standard */
  grid-template-columns: 1fr 1fr; 
  gap: 0.75rem;
  margin-top: 1rem;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* 1. LABEL STYLING (Tiny & Sharp) */
.stat-label {
  font-size: 0.65rem; /* Fixed small size */
  color: #a1a1aa;     /* Zinc-400 */
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.05em;
}

/* 2. VALUE STYLING (The problem area) */
.stat-value {
  font-weight: 700;
  /* Force single line so it doesn't stack awkwardly */
  white-space: nowrap; 
  line-height: 1.2;
}

/* 3. DESKTOP OVERRIDES (The Fix) */
@media (min-width: 1024px) {
  .card-stats-grid {
    /* On large screens, use more columns if needed, or keep compact */
    grid-template-columns: repeat(2, 1fr); 
    gap: 0.5rem; /* Tighter gap */
    margin-top: 0.75rem;
    padding-top: 0.5rem;
  }

  .stat-value {
    /* Cap the font size on desktop so it doesn't look huge */
    font-size: 0.85rem !important; 
    letter-spacing: 0;
  }

  .stat-label {
    /* Keep label tiny on desktop */
    font-size: 0.6rem !important; 
  }
  
  /* Optional: Arrange Trend and Confidence side-by-side more tightly */
  .stat-item {
    align-items: flex-start; 
  }
}

/* --- COLOR HELPERS --- */
.stat-value.gold {
  color: #facc15; /* Yellow-400 */
  text-shadow: 0 0 10px rgba(234, 179, 8, 0.2);
}
/* ======================== */
/*   UNSUBSCRIBE PAGE UI    */
/* ======================== */

/* Shake Animation for Error State */
@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
  20%, 40%, 60%, 80% { transform: translateX(4px); }
}

.shake {
  animation: shakeX 0.6s cubic-bezier(.36,.07,.19,.97) both;
}

.zoom-in {
  animation: zoomIn 0.4s ease forwards;
}

@keyframes zoomIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
/* ======================================================== */
/*   UNSUBSCRIBE PAGE STYLES                                */
/* ======================================================== */

/* General Background Gradient for Unsub Page */
.unsub-page-bg {
  background: radial-gradient(circle at center, #1a1a1d 0%, #000000 100%);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

/* 1. KEYFRAME ANIMATIONS */

/* Soft Fade In */
@keyframes fadeInSoft {
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}

/* Success Zoom In */
@keyframes zoomInBounce {
  0% { opacity: 0; transform: scale(0.8); }
  70% { transform: scale(1.05); }
  100% { opacity: 1; transform: scale(1); }
}

/* Error Shake */
@keyframes shakeHorizontal {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
  20%, 40%, 60%, 80% { transform: translateX(5px); }
}

/* Spinner Rotate */
@keyframes spinFull {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 2. UTILITY CLASSES (Used by Tailwind component usually, but enforced here) */

.animate-fade-in {
  animation: fadeInSoft 0.6s ease-out forwards;
}

.animate-zoom-in {
  animation: zoomInBounce 0.5s ease-out forwards;
}

.animate-shake {
  animation: shakeHorizontal 0.5s cubic-bezier(.36,.07,.19,.97) both;
}

.animate-spin-slow {
  animation: spinFull 1.5s linear infinite;
}

/* 3. CARD SPECIFIC STYLING (Optional overrides) */
.unsub-card {
  background: #09090b; /* Zinc 950 */
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  padding: 2.5rem;
  max-width: 420px;
  width: 100%;
  text-align: center;
}

.unsub-icon-circle {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem auto;
}

.icon-bg-green { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
.icon-bg-red { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
.icon-bg-yellow { background: rgba(234, 179, 8, 0.1); color: #eab308; }

.unsub-title {
  color: white;
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.unsub-text {
  color: #a1a1aa; /* Zinc 400 */
  font-size: 0.875rem;
