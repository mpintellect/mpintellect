  overflow: hidden;
}

.glass-trend-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(249, 115, 22, 0.1), transparent);
  transition: left 0.8s ease;
}

.glass-trend-card:hover::before {
  left: 100%;
