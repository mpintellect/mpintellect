}

/* Button style reinforcement */
.btn-gold {
  background: var(--gold-primary);
  color: #000;
  border-radius: 8px;
  font-weight: 900;
  text-transform: uppercase;
  padding: 12px 24px;
  border: none;
  cursor: pointer;
}
/* ==========================================
   📱 MOBILE COMPACT OVERRIDES (Small & Elegant)
   ========================================== */

@media (max-width: 768px) {
  /* 1. Shrink the Overlay Padding */
  .modal-overlay {
    padding: 10px;
  }

  /* 2. Global Modal Window Shrink */
  .modal-content, .pricing-modal {
    padding: 20px 15px !important; /* Reduced from 40px */
    border-radius: 20px;
  }

  /* 3. Pricing Slider - Smaller Slats */
  .pricing-options {
    padding: 20px 5px !important;
    gap: 10px !important;
  }

  .pricing-card {
