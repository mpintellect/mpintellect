    color: black;
    border: 1px solid #ccc;
  }
  
  .seo-chip-link {
    display: none;
  }
  
  .accuracy-ring {
    animation: none;
  }
}

/* Inline Block for Final Forecast */
.inline-block {
  display: inline-block;
}

/* Shrink Utility */
.shrink-0 {
  flex-shrink: 0;
}
/* globales.css - Elegant Analysis Matrix Styles */

/* Base Reset & Global Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background: #000000;
  color: #ffffff;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

/* Selection Styling */
::selection {
  background: rgba(59, 130, 246, 0.3); /* blue-500/30 */
}

/* Typography Scale */
.text-\[10px\] { font-size: 0.625rem; }
.text-xs { font-size: 0.75rem; line-height: 1rem; }
.text-sm { font-size: 0.875rem; line-height: 1.25rem; }
.text-base { font-size: 1rem; line-height: 1.5rem; }
.text-lg { font-size: 1.125rem; line-height: 1.75rem; }
.text-xl { font-size: 1.25rem; line-height: 1.75rem; }
.text-2xl { font-size: 1.5rem; line-height: 2rem; }
.text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
.text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
.text-5xl { font-size: 3rem; line-height: 1; }

/* Font Weights */
.font-light { font-weight: 300; }
.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }

/* Font Families */
.font-mono { font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Monaco, Consolas, monospace; }
.font-sans { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }

/* Tracking */
.tracking-tight { letter-spacing: -0.025em; }
.tracking-tighter { letter-spacing: -0.05em; }
.tracking-wider { letter-spacing: 0.05em; }
.tracking-widest { letter-spacing: 0.1em; }

/* Glass Morphism Effects */
.bento-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.bento-card:hover {
  border-color: rgba(255, 255, 255, 0.15);
  transform: translateY(-2px);
}

/* Thermal Wave Animation */
@keyframes thermal-pulse {
  0%, 100% {
    opacity: 0.4;
    transform: scaleY(1);
  }
  50% {
    opacity: 0.7;
    transform: scaleY(1.05);
  }
}

@keyframes progress-glow {
  0%, 100% {
    box-shadow: 0 0 5px currentColor;
  }
  50% {
    box-shadow: 0 0 15px currentColor;
  }
}

/* Flexbox Utilities */
.flex { display: flex; }
.inline-flex { display: inline-flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1 1 0%; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-start { justify-content: flex-start; }
.justify-end { justify-content: flex-end; }

/* Grid System */
.grid { display: grid; }
.grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.md\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.md\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.md\:col-span-2 { grid-column: span 2 / span 2; }
.md\:row-span-2 { grid-row: span 2 / span 2; }

/* Gap Utilities */
.gap-3 { gap: 0.75rem; }
.gap-4 { gap: 1rem; }
.gap-6 { gap: 1.5rem; }
.gap-8 { gap: 2rem; }

/* Spacing - Margin */
.m-0 { margin: 0; }
.mb-1 { margin-bottom: 0.25rem; }
.mb-2 { margin-bottom: 0.5rem; }
.mb-3 { margin-bottom: 0.75rem; }
.mb-4 { margin-bottom: 1rem; }
.mb-5 { margin-bottom: 1.25rem; }
.mb-6 { margin-bottom: 1.5rem; }
.mt-1 { margin-top: 0.25rem; }
.mt-2 { margin-top: 0.5rem; }
.mt-6 { margin-top: 1.5rem; }
.mt-8 { margin-top: 2rem; }
.mt-10 { margin-top: 2.5rem; }
.mt-24 { margin-top: 6rem; }
.mx-auto { margin-left: auto; margin-right: auto; }

/* Spacing - Padding */
.p-2 { padding: 0.5rem; }
.p-4 { padding: 1rem; }
.p-8 { padding: 2rem; }
.px-2 { padding-left: 0.5rem; padding-right: 0.5rem; }
.px-4 { padding-left: 1rem; padding-right: 1rem; }
.px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
.px-8 { padding-left: 2rem; padding-right: 2rem; }
.py-1 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
.py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
.py-4 { padding-top: 1rem; padding-bottom: 1rem; }
.py-8 { padding-top: 2rem; padding-bottom: 2rem; }
.pt-4 { padding-top: 1rem; }
.pt-8 { padding-top: 2rem; }
.pt-10 { padding-top: 2.5rem; }
.pt-28 { padding-top: 7rem; }
.pb-8 { padding-bottom: 2rem; }
.pb-24 { padding-bottom: 6rem; }
.pl-4 { padding-left: 1rem; }

/* Width & Height */
.w-full { width: 100%; }
.w-px { width: 1px; }

.h-3 { height: 0.75rem; }
.h-40 { height: 10rem; }
.h-full { height: 100%; }

/* Positioning */
.relative { position: relative; }
.absolute { position: absolute; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }

/* Top, Right, Bottom, Left */
.top-0 { top: 0; }
.right-0 { right: 0; }
.bottom-0 { bottom: 0; }
.left-0 { left: 0; }

/* Transform */
.group:hover .group-hover\:border-blue-900\/50 {
  border-color: rgba(30, 58, 138, 0.5);
}

/* Border Radius */
.rounded { border-radius: 0.25rem; }
.rounded-lg { border-radius: 0.5rem; }
.rounded-xl { border-radius: 0.75rem; }
.rounded-2xl { border-radius: 1rem; }
.rounded-3xl { border-radius: 1.5rem; }
.rounded-full { border-radius: 9999px; }

/* Border Width */
.border { border-width: 1px; }
.border-t { border-top-width: 1px; }
.border-b { border-bottom-width: 1px; }
.border-l { border-left-width: 1px; }
.border-l-2 { border-left-width: 2px; }

/* Border Colors */
.border-zinc-800 { border-color: #27272a; }
.border-zinc-800\/50 { border-color: rgba(39, 39, 42, 0.5); }
.border-zinc-900 { border-color: #18181b; }
.border-blue-500 { border-color: #3b82f6; }
.border-blue-500\/30 { border-color: rgba(59, 130, 246, 0.3); }
.border-blue-900\/50 { border-color: rgba(30, 58, 138, 0.5); }
.border-white\/5 { border-color: rgba(255, 255, 255, 0.05); }
.border-white\/15 { border-color: rgba(255, 255, 255, 0.15); }

/* Background Colors */
.bg-black { background-color: #000000; }
.bg-white { background-color: #ffffff; }
.bg-zinc-800 { background-color: #27272a; }
.bg-zinc-900 { background-color: #18181b; }
.bg-zinc-900\/40 { background-color: rgba(24, 24, 27, 0.4); }
.bg-zinc-900\/50 { background-color: rgba(24, 24, 27, 0.5); }
.bg-zinc-950 { background-color: #09090b; }
.bg-black\/40 { background-color: rgba(0, 0, 0, 0.4); }
.bg-\[\#0c0c0e\] { background-color: #0c0c0e; }
.bg-blue-500\/10 { background-color: rgba(59, 130, 246, 0.1); }
.bg-blue-600\/5 { background-color: rgba(37, 99, 235, 0.05); }
.bg-blue-900\/10 { background-color: rgba(30, 58, 138, 0.1); }
.bg-purple-500\/10 { background-color: rgba(168, 85, 247, 0.1); }
.bg-amber-500\/10 { background-color: rgba(245, 158, 11, 0.1); }
.bg-red-500\/20 { background-color: rgba(239, 68, 68, 0.2); }
.bg-green-500\/20 { background-color: rgba(34, 197, 94, 0.2); }
.bg-emerald-500 { background-color: #10b981; }
.bg-purple-500 { background-color: #a855f7; }

/* Gradient Backgrounds */
.bg-gradient-to-b {
  background-image: linear-gradient(to bottom, var(--tw-gradient-stops));
}

.bg-gradient-to-r {
  background-image: linear-gradient(to right, var(--tw-gradient-stops));
}

.from-zinc-900 { --tw-gradient-from: #18181b; }
.from-zinc-900\/50 { --tw-gradient-from: rgba(24, 24, 27, 0.5); }
.to-black { --tw-gradient-to: #000000; }
.from-blue-600 { --tw-gradient-from: #2563eb; }
.to-cyan-400 { --tw-gradient-to: #22d3ee; }

/* Text Colors */
.text-white { color: #ffffff; }
.text-zinc-300 { color: #d4d4d8; }
.text-zinc-400 { color: #a1a1aa; }
.text-zinc-500 { color: #71717a; }
.text-zinc-600 { color: #52525b; }
.text-blue-400 { color: #60a5fa; }
.text-purple-400 { color: #c084fc; }
.text-amber-400 { color: #fbbf24; }
.text-red-400 { color: #f87171; }
.text-green-400 { color: #4ade80; }
.text-yellow-400 { color: #facc15; }
.text-cyan-400 { color: #22d3ee; }

/* Text Transform */
.uppercase { text-transform: uppercase; }
.capitalize { text-transform: capitalize; }

/* Text Alignment */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

/* Overflow */
.overflow-hidden { overflow: hidden; }

/* Opacity */
.opacity-60 { opacity: 0.6; }

/* Line Height */
.leading-relaxed { line-height: 1.625; }
.leading-tight { line-height: 1.25; }

/* Whitespace */
.whitespace-nowrap { white-space: nowrap; }

/* Filter Effects */
.blur-3xl {
  filter: blur(64px);
}

.filter-blur-20px {
  filter: blur(20px);
}

/* Progress Bar Animations */
.progress-bar {
  animation: progress-glow 2s ease-in-out infinite;
  transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.thermal-wave {
  animation: thermal-pulse 3s ease-in-out infinite;
  transition: height 1s ease-in-out, background-color 0.5s ease;
}

/* SEO Chip Links */
.seo-chip-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 2rem;
  color: #ffffff;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(10px);
  position: relative;
  overflow: hidden;
}

.seo-chip-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
  transition: left 0.5s ease;
}

.seo-chip-link:hover::before {
  left: 100%;
}

.seo-chip-link:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(59, 130, 246, 0.3);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.2);
}

/* Special highlighted chip */
.seo-chip-link.text-white {
  background: rgba(59, 130, 246, 0.1);
  border-color: rgba(59, 130, 246, 0.3);
}

.seo-chip-link.text-white:hover {
  background: rgba(59, 130, 246, 0.2);
  border-color: rgba(59, 130, 246, 0.5);
}

/* Responsive Design */
@media (max-width: 768px) {
  .text-4xl {
    font-size: 2rem;
    line-height: 1.2;
  }
  
  .text-5xl {
    font-size: 2.5rem;
    line-height: 1.2;
  }
  
  .bento-card {
    margin: 0 -0.5rem;
    border-radius: 1rem;
  }
  
  .seo-chip-link {
    width: 100%;
    justify-content: center;
  }
  
  /* Mobile grid adjustments */
  .grid-cols-2 {
    grid-template-columns: 1fr;
  }
  
  .grid-cols-4 {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .md\:col-span-2 {
    grid-column: 1;
  }
  
  .md\:row-span-2 {
    grid-row: auto;
  }
  
  /* Header mobile adjustments */
  .flex-col.md\:flex-row {
    flex-direction: column;
    text-align: center;
    gap: 2rem;
  }
  
  .text-right {
    text-align: center;
  }
  
  /* Thermal chart mobile */
  .h-40 {
    height: 8rem;
  }
  
  .px-8 {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}

@media (max-width: 640px) {
  .px-6 {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  .pt-28 {
    padding-top: 5rem;
  }
  
  .p-8 {
    padding: 1.5rem;
  }
  
  .text-4xl {
    font-size: 1.75rem;
  }
  
  .text-5xl {
    font-size: 2rem;
  }
  
  .grid-cols-4 {
    grid-template-columns: 1fr;
  }
  
  .h-40 {
    height: 6rem;
  }
  
  .text-3xl {
    font-size: 1.5rem;
  }
  
  .text-xl {
    font-size: 1.125rem;
  }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #000000;
}

::-webkit-scrollbar-thumb {
  background: rgba(59, 130, 246, 0.3);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(59, 130, 246, 0.5);
}

/* Focus States for Accessibility */
button:focus-visible,
a:focus-visible,
.seo-chip-link:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

/* Reduced Motion Support */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  
  .bento-card:hover {
    transform: none;
  }
  
  .seo-chip-link::before {
    display: none;
  }
  
  .progress-bar,
  .thermal-wave {
    animation: none;
  }
  
  html {
    scroll-behavior: auto;
  }
}

/* High Contrast Mode Support */
@media (prefers-contrast: high) {
  .bento-card {
    background: #000000;
    border: 2px solid #3b82f6;
  }
  
  .seo-chip-link {
    border: 2px solid #3b82f6;
  }
}

/* Print Styles */
@media print {
  .bento-card {
    background: white;
    color: black;
    border: 1px solid #ccc;
  }
  
  .seo-chip-link {
    display: none;
  }
  
  .thermal-wave {
    animation: none;
  }
}

/* Utility Classes */
.space-y-3 > * + * {
  margin-top: 0.75rem;
}

.space-y-4 > * + * {
  margin-top: 1rem;
}

.group {
  position: relative;
}

.transition {
  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.transition-all {
  transition-property: all;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.duration-500 {
  transition-duration: 500ms;
}

.duration-1000 {
  transition-duration: 1000ms;
}

.duration-1500 {
  transition-duration: 1500ms;
}

/* Strong text styling */
strong {
  font-weight: 600;
  color: #ffffff;
}
/* globales.css - Mobile-First Responsive Styles */

/* Base Mobile-First Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 14px; /* Base font size for mobile */
  scroll-behavior: smooth;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background: #000000;
  color: #ffffff;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  padding: 0;
  margin: 0;
}

/* Mobile-First Container */
.container-mobile {
  width: 100%;
  padding-left: 1rem;
  padding-right: 1rem;
  margin-left: auto;
  margin-right: auto;
}

/* Mobile Typography Scale */
.text-xs { font-size: 0.7rem; }
.text-sm { font-size: 0.8rem; }
.text-base { font-size: 0.9rem; }
.text-lg { font-size: 1rem; }
.text-xl { font-size: 1.125rem; }
.text-2xl { font-size: 1.375rem; }
.text-3xl { font-size: 1.625rem; }
.text-4xl { font-size: 1.875rem; }
.text-5xl { font-size: 2.25rem; }
.text-6xl { font-size: 2.5rem; }

/* Mobile Spacing */
.p-mobile { padding: 1rem; }
.px-mobile { padding-left: 1rem; padding-right: 1rem; }
.py-mobile { padding-top: 1rem; padding-bottom: 1rem; }

/* Mobile Grid System */
.mobile-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

/* Mobile Header Adjustments */
.mobile-header {
  padding-top: 5rem !important;
  padding-bottom: 2rem !important;
}

.mobile-header h1 {
  font-size: 2rem !important;
  line-height: 1.2 !important;
  text-align: center;
}

.mobile-header p {
  font-size: 0.9rem !important;
  text-align: center;
}

/* Mobile Card Stack */
.mobile-card-stack {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin: 0 -1rem;
}

.mobile-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1rem;
  padding: 1.5rem;
  margin: 0 1rem;
}

/* Mobile Navigation */
.mobile-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding: 0.75rem 1rem;
  z-index: 1000;
}

.mobile-nav-links {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.mobile-nav-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  color: #a1a1aa;
  font-size: 0.7rem;
  gap: 0.25rem;
}

.mobile-nav-link.active {
  color: #3b82f6;
}

/* Mobile Charts & Visualizations */
.mobile-chart-container {
  width: 100%;
  height: 200px;
  position: relative;
  overflow: hidden;
}

.mobile-gauge {
  width: 150px !important;
  height: 150px !important;
  margin: 0 auto;
}

.mobile-progress-bar {
  height: 0.5rem !important;
}

/* Mobile Button Sizes */
.mobile-btn {
  padding: 0.875rem 1.5rem !important;
  font-size: 0.9rem !important;
  width: 100% !important;
  justify-content: center !important;
}

/* Mobile Form Elements */
.mobile-input {
  font-size: 1rem !important; /* Prevents zoom on iOS */
  padding: 0.875rem !important;
  width: 100% !important;
}

/* Mobile-Specific Media Queries */

/* Small phones (up to 360px) */
@media (max-width: 360px) {
  html {
    font-size: 13px;
  }
  
  .mobile-card {
    padding: 1rem;
    margin: 0 0.5rem;
  }
  
  .mobile-header {
    padding-top: 4rem !important;
  }
}

/* Phones (361px - 767px) */
@media (min-width: 361px) and (max-width: 767px) {
  .container-mobile {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

/* Tablets (768px - 1023px) */
@media (min-width: 768px) and (max-width: 1023px) {
  html {
    font-size: 15px;
  }
  
  .mobile-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .container-mobile {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}

/* Desktop (1024px and up) */
@media (min-width: 1024px) {
  html {
    font-size: 16px;
  }
}

/* Mobile-Specific Component Overrides */

/* Trend Page Mobile */
@media (max-width: 767px) {
  .trend-gauge-mobile {
    width: 200px !important;
    height: 200px !important;
  }
  
  .trend-metrics-mobile {
    grid-template-columns: 1fr !important;
    gap: 0.75rem !important;
  }
}

/* Volatility Page Mobile */
@media (max-width: 767px) {
  .volatility-bar-mobile {
    height: 1.5rem !important;
  }
  
  .volatility-stats-mobile {
    grid-template-columns: 1fr !important;
  }
}

/* Momentum Page Mobile */
@media (max-width: 767px) {
  .momentum-meter-mobile {
    height: 2rem !important;
  }
  
  .rsi-needle-mobile {
    width: 0.25rem !important;
  }
}

/* Zones Page Mobile */
@media (max-width: 767px) {
  .zones-bar-mobile {
    height: 12rem !important;
    width: 3rem !important;
    margin: 0 auto;
  }
  
  .price-marker-mobile {
    right: -3rem !important;
  }
}

/* Forecast Page Mobile */
@media (max-width: 767px) {
  .forecast-ring-mobile {
    width: 120px !important;
    height: 120px !important;
  }
  
  .confidence-text-mobile {
    font-size: 1rem !important;
    text-align: center !important;
  }
}

/* Analysis Page Mobile */
@media (max-width: 767px) {
  .bento-grid-mobile {
    grid-template-columns: 1fr !important;
    gap: 1rem !important;
  }
  
  .thermal-chart-mobile {
    height: 8rem !important;
  }
  
  .stats-grid-mobile {
    grid-template-columns: 1fr !important;
  }
}

/* Touch-Friendly Sizes */
.touch-target {
  min-height: 44px;
  min-width: 44px;
  padding: 0.75rem;
}

.touch-text {
  font-size: 1rem;
  line-height: 1.4;
}

/* Mobile Performance Optimizations */
.mobile-reduced-animations * {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
}

/* Mobile Safe Areas (Notch devices) */
@supports(padding: max(0px)) {
  .mobile-safe-top {
    padding-top: max(1rem, env(safe-area-inset-top));
  }
  
  .mobile-safe-bottom {
    padding-bottom: max(1rem, env(safe-area-inset-bottom));
  }
  
  .mobile-safe-left {
    padding-left: max(1rem, env(safe-area-inset-left));
  }
  
  .mobile-safe-right {
    padding-right: max(1rem, env(safe-area-inset-right));
  }
}

/* Mobile Scroll Improvements */
.mobile-smooth-scroll {
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

/* Mobile Image Optimization */
.mobile-img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Mobile Loading States */
.mobile-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  gap: 1rem;
}

.mobile-spinner {
  width: 2rem;
  height: 2rem;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top: 2px solid #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Mobile Error States */
.mobile-error {
  text-align: center;
  padding: 2rem;
  color: #a1a1aa;
}

.mobile-error .icon {
  font-size: 3rem;
  margin-bottom: 1rem;
  opacity: 0.5;
}

/* Utility Classes for Mobile */
.mobile-text-center { text-align: center !important; }
.mobile-text-left { text-align: left !important; }
.mobile-text-right { text-align: right !important; }

.mobile-hidden { display: none !important; }
.mobile-block { display: block !important; }
.mobile-flex { display: flex !important; }
.mobile-grid { display: grid !important; }

.mobile-w-full { width: 100% !important; }
.mobile-h-auto { height: auto !important; }

.mobile-m-0 { margin: 0 !important; }
.mobile-mt-2 { margin-top: 0.5rem !important; }
.mobile-mb-2 { margin-bottom: 0.5rem !important; }
.mobile-mx-auto { margin-left: auto !important; margin-right: auto !important; }

.mobile-p-0 { padding: 0 !important; }
.mobile-p-4 { padding: 1rem !important; }

/* Mobile-First Media Query for Desktop */
@media (min-width: 768px) {
  .mobile-only { display: none !important; }
}

@media (max-width: 767px) {
  .desktop-only { display: none !important; }
}

/* Print Styles for Mobile */
@media print {
  .mobile-nav,
  .seo-chip-link,
  .notification-button {
    display: none !important;
  }
  
  body {
    background: white !important;
    color: black !important;
  }
  
  .mobile-card {
    background: white !important;
    border: 1px solid #ccc !important;
    break-inside: avoid;
  }
}
