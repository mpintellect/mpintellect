}

/* 4. TYPOGRAPHY - Executive Shrift */
.plan-name {
  font-size: 10px;
  font-weight: 800;
  color: var(--gold-soft);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 4px;
}

.plan-price {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.8rem; /* petite & sharp */
  font-weight: 200; /* thin luxury shrift */
  color: #fff;
