  font-weight: 600;
  padding: 0.75rem 1.25rem;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.submit-button:hover,
.reset-button:hover {
  background-color: #ffe44d;
  transform: translateY(-1px);
}
@media (max-width: 480px) {
  .chatbot-input {
    flex-direction: column;
    align-items: stretch;
  }

  .submit-button,
  .reset-button {
    width: 100%;
  }
}
