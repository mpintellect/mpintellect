{
  "name": "mzprimer-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "landing",
    "dashboard"
  ],
  "scripts": {
  "dev:landing": "cd landing && npm run dev",
  "dev:dashboard": "cd dashboard && npm run dev",
  "build:landing": "cd landing && npm run build",
  "build:dashboard": "cd dashboard && npm run build",
  "dev": "concurrently \"npm run dev:landing\" \"npm run dev:dashboard\"",
  "build": "npm run build:landing && npm run build:dashboard",
    "install:all": "npm install",
    "prebuild": "rm -rf .next out",
    "preview": "npm run build && npx wrangler pages dev out --compatibility-flags=nodejs_compat --d1 DB",
    "cf:dev": "npx wrangler pages dev --port 3000 --proxy 3001 --command \"next dev -p 3001\" --compatibility-flags=nodejs_compat --d1 DB",
    "test:functions": "npx wrangler pages dev --port 8788",
    "dev:full": "concurrently \"npm run dev\" \"npm run test:functions\"",
    "test:production": "npm run build && npx serve@latest out"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@noble/secp256k1": "^3.0.0",
    "@stripe/stripe-js": "^7.9.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/og": "^0.8.5",
    "axios": "^1.11.0",
    "bs58check": "^4.0.0",
    "buffer": "^6.0.3",
    "client-only": "^0.0.1",
    "crypto-browserify": "^3.12.1",
    "elliptic": "^6.6.1",
    "framer-motion": "^12.23.12",
    "jsonwebtoken": "^9.0.2",
    "keccak": "^3.0.4",
    "lucide-react": "^0.536.0",
    "next": "^16.1.1",
    "next-sitemap": "^4.2.3",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.4",
    "recharts": "^3.4.1",
    "resend": "^6.0.2",
    "stream-browserify": "^3.0.0",
    "stripe": "^18.5.0",
    "tronweb": "^6.0.4",
    "uuid": "^13.0.0",
    "vercel": "^50.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/axios": "^0.9.36",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "compression-webpack-plugin": "^11.1.0",
    "dotenv": "^17.2.2",
    "eslint": "9.33.0",
    "eslint-config-next": "15.5.0",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.1.1",
    "tiny-secp256k1": "^2.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "wrangler": "^4.61.0"
  }
}
