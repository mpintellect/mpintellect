{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/trade/layout,_N_T_/trade/[symbol]/layout,_N_T_/trade/[symbol]/page,_N_T_/trade/BTCUSD"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/trade/$d$symbol/__PAGE__",
    "/trade/$d$symbol",
    "/trade",
    "/_index",
    "/_head"
  ]
}