  transform: translateY(-1px);
}
/* ================================================= */
/*   UNSUBSCRIBE PAGE (System Notification Style)    */
/* ================================================= */

/* 1. Page Background (Deep void with gold ambient light) */
.unsub-page-wrapper {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  
  /* Deep Luxury Black */
  background-color: #050505;
  background-image: 
    radial-gradient(circle at 50% 0%, rgba(234, 179, 8, 0.08) 0%, transparent 50%),
    linear-gradient(to bottom, #050505 0%, #000 100%);
}

/* 2. The Main Glass Card */
.unsub-card {
  width: 100%;
  max-width: 30rem; /* ~480px */
  text-align: center;
  padding: 3rem 2rem;
  
  /* Glass Material */
  background: rgba(18, 18, 18, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  
  /* Thin Borders */
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-top: 1px solid rgba(234, 179, 8, 0.3); /* Subtle gold top */
  border-radius: 24px;
  
  /* Deep shadow */
  box-shadow: 
    0 40px 80px -20px rgba(0, 0, 0, 0.9),
    0 0 0 1px rgba(0,0,0,1);
    
  position: relative;
  overflow: hidden;
  
  /* Entrance Animation */
  animation: slideUpUnsub 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUpUnsub {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

/* 3. Icons Wrapper (Status Circles) */
.unsub-icon-circle {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin: 0 auto 1.5rem auto;
  
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* Glow Effect */
  box-shadow: 0 0 30px rgba(0,0,0,0.5);
  animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.2s forwards;
  opacity: 0; transform: scale(0.5);
}

@keyframes popIn {
  to { opacity: 1; transform: scale(1); }
}

/* Status Colors */
.status-loading { 
  background: rgba(234, 179, 8, 0.1); 
  border: 1px solid rgba(234, 179, 8, 0.2); 
  color: #facc15; 
}
.status-success { 
  background: rgba(34, 197, 94, 0.1); 
  border: 1px solid rgba(34, 197, 94, 0.2); 
  color: #4ade80; 
}
.status-error { 
  background: rgba(239, 68, 68, 0.1); 
  border: 1px solid rgba(239, 68, 68, 0.2); 
  color: #f87171; 
}

/* 4. Typography */
.unsub-title {
  color: white;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 1.75rem;
  font-weight: 800;
  margin-bottom: 0.75rem;
  letter-spacing: -0.02em;
}

.unsub-text {
  color: #a1a1aa; /* Zinc 400 */
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 2rem;
  max-width: 90%;
  margin-left: auto;
  margin-right: auto;
}

.email-highlight {
  color: #facc15; /* Yellow */
  background: rgba(234, 179, 8, 0.1);
  padding: 2px 8px;
  border-radius: 6px;
  font-family: monospace;
  border: 1px solid rgba(234, 179, 8, 0.15);
}

/* 5. Return Button */
.unsub-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  
  background: #ffffff;
  color: #000000;
  font-weight: 700;
  font-size: 0.9rem;
  
  padding: 12px 28px;
  border-radius: 12px;
  text-decoration: none;
  
  transition: all 0.2s ease;
  box-shadow: 0 4px 12px rgba(255,255,255,0.15);
}

.unsub-btn-primary:hover {
  background: #f4f4f5;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(255,255,255,0.25);
}

/* Error Secondary Button */
.unsub-btn-secondary {
  color: #a1a1aa;
  font-size: 0.85rem;
  text-decoration: underline;
  text-underline-offset: 4px;
  transition: 0.2s;
}
.unsub-btn-secondary:hover { color: white; }
/* ================================================== */
/*   ENHANCED SEO / ANALYSIS PAGE STYLES              */
/* ================================================== */

/* Page Background with Better Mobile Support */
.seo-page-bg {
  background-color: #000;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  min-height: 100vh;
  min-height: 100dvh; /* Dynamic viewport height for mobile */
  padding: 5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Enhanced Container Spacing - Pushed Lower */
.seo-page-container {
  width: 100%;
  max-width: 28rem; /* Better mobile width */
  margin-top: 2rem; /* Pushes content lower */
  margin-bottom: 2rem;
}

/* Main Glass Card - Mobile Optimized */
.seo-signal-card {
  position: relative;
  background: rgba(10, 10, 10, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px; /* Slightly smaller for mobile */
  overflow: hidden;
  box-shadow: 
    0 0 0 1px rgba(0,0,0,1), 
    0 20px 40px -20px rgba(0, 0, 0, 0.8),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  margin: 0 auto;
}

/* Enhanced Color Themes with Better Mobile Visibility */
.theme-buy {
  border-color: rgba(16, 185, 129, 0.4);
  box-shadow: 
    0 0 40px -10px rgba(16, 185, 129, 0.2),
    inset 0 1px 0 rgba(16, 185, 129, 0.1);
}

.theme-sell {
  border-color: rgba(239, 68, 68, 0.4);
  box-shadow: 
    0 0 40px -10px rgba(239, 68, 68, 0.2),
    inset 0 1px 0 rgba(239, 68, 68, 0.1);
}

/* Enhanced Text Gradients */
.text-buy { 
  background: linear-gradient(135deg, #ffffff 0%, #10b981 50%, #059669 100%);
  -webkit-background-clip: text; 
  background-clip: text; 
  color: transparent;
  text-shadow: 0 0 40px rgba(16, 185, 129, 0.4);
}

.text-sell {
  background: linear-gradient(135deg, #ffffff 0%, #ef4444 50%, #dc2626 100%);
  -webkit-background-clip: text; 
  background-clip: text; 
  color: transparent;
  text-shadow: 0 0 40px rgba(239, 68, 68, 0.4);
}

/* Enhanced Metric Boxes - Mobile Responsive */
.seo-metric-box {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  padding: 1.25rem; /* Reduced padding for mobile */
  display: flex; 
  flex-direction: column; 
  gap: 0.5rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.seo-metric-box::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.02), transparent);
  transition: left 0.6s ease;
}

.seo-metric-box:hover::before {
  left: 100%;
}

.seo-metric-box:hover {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  border-color: rgba(255, 255, 255, 0.1);
  transform: translateY(-3px);
}

.seo-label {
  font-size: 0.7rem; 
  font-weight: 700; 
  text-transform: uppercase; 
  letter-spacing: 0.1em; 
  color: #71717a;
  line-height: 1.2;
}

.seo-value {
  font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
  font-size: 1.25rem; /* Slightly smaller for mobile */
  font-weight: 700; 
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* Enhanced AI Terminal - Mobile Optimized */
.seo-terminal {
  background: linear-gradient(135deg, #09090b 0%, #0a0a0a 100%);
  border: 1px solid #27272a;
  border-radius: 12px;
  padding: 1rem;
  margin-top: 1.5rem;
  text-align: left;
  box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.5);
}

.seo-terminal-header {
  display: flex; 
  align-items: center; 
  gap: 0.5rem;
  padding-bottom: 0.75rem; 
  border-bottom: 1px solid #27272a;
  margin-bottom: 0.75rem;
}

.seo-terminal-content {
  font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
  font-size: 0.75rem;
  line-height: 1.5;
  color: #d4d4d8;
  
  /* Enhanced scroll with better mobile handling */
  max-height: 120px; 
  overflow-y: auto;
  white-space: pre-line;
  padding-right: 0.5rem;
  
  /* Better text rendering */
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

/* Enhanced Scrollbar */
.seo-terminal-content::-webkit-scrollbar { 
  width: 4px; 
}
.seo-terminal-content::-webkit-scrollbar-track { 
  background: transparent; 
}
.seo-terminal-content::-webkit-scrollbar-thumb { 
  background: #52525b; 
  border-radius: 2px; 
}
.seo-terminal-content::-webkit-scrollbar-thumb:hover { 
  background: #71717a; 
}

/* Enhanced Lock/CTA Box with Better Mobile Spacing */
.seo-lock-box {
  background: linear-gradient(180deg, rgba(24, 24, 27, 0) 0%, rgba(24, 24, 27, 0.8) 100%);
  padding: 2rem 1rem 1rem;
  margin-top: 2rem;
  position: relative;
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
  border-radius: 0 0 20px 20px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

/* Enhanced CTA Button - Mobile Friendly */
.seo-cta-button {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  color: #000000;
  border: none;
  padding: 1rem 2rem;
  border-radius: 50px;
  font-weight: 700;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  box-shadow: 
    0 8px 25px rgba(255, 255, 255, 0.15),
    0 0 0 1px rgba(255, 255, 255, 0.1);
  width: 100%;
  max-width: 280px;
  margin: 0 auto;
  display: block;
}

.seo-cta-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.6s ease;
}

.seo-cta-button:hover::before {
  left: 100%;
}

.seo-cta-button:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 
    0 15px 35px rgba(255, 255, 255, 0.2),
    0 0 0 1px rgba(255, 255, 255, 0.2);
}

/* ================================================== */
/*   MOBILE RESPONSIVE BREAKPOINTS                   */
/* ================================================== */

/* Small Phones (up to 375px) */
@media (max-width: 375px) {
  .seo-page-bg {
    padding: 0.75rem;
    background-size: 30px 30px; /* Smaller grid for small screens */
  }
  
  .seo-page-container {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  
  .seo-signal-card {
    border-radius: 16px;
  }
  
  .seo-metric-box {
    padding: 1rem;
  }
  
  .seo-value {
    font-size: 1.125rem;
  }
  
  .text-buy,
  .text-sell {
    font-size: 2.5rem !important; /* Adjust main action text */
  }
}

/* Medium Phones (376px - 428px) */
@media (min-width: 376px) and (max-width: 428px) {
  .seo-page-container {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .text-buy,
  .text-sell {
    font-size: 3rem !important;
  }
}

/* Large Phones (429px - 768px) */
@media (min-width: 429px) and (max-width: 768px) {
  .seo-page-container {
    max-width: 24rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  
  .text-buy,
  .text-sell {
    font-size: 3.5rem !important;
  }
}

/* Tablet and Desktop (769px+) */
@media (min-width: 769px) {
  .seo-page-container {
    max-width: 28rem;
    margin-top: 3rem; /* More space on desktop */
    margin-bottom: 3rem;
  }
  
  .seo-signal-card {
    border-radius: 24px;
  }
}

/* ================================================== */
/*   ENHANCED ACCESSIBILITY & INTERACTIONS           */
/* ================================================== */

/* Focus states for accessibility */
.seo-cta-button:focus {
  outline: 2px solid rgba(59, 130, 246, 0.8);
  outline-offset: 2px;
}

.seo-metric-box:focus-within {
  outline: 1px solid rgba(255, 255, 255, 0.2);
  outline-offset: 2px;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .seo-metric-box,
  .seo-cta-button,
  .seo-signal-card {
    transition: none;
  }
  
  .seo-metric-box::before,
  .seo-cta-button::before {
    display: none;
  }
}

/* Dark mode enhancements (if needed) */
@media (prefers-color-scheme: dark) {
  .seo-terminal {
    background: linear-gradient(135deg, #0a0a0a 0%, #000000 100%);
  }
}

/* Touch device optimizations */
@media (hover: none) and (pointer: coarse) {
  .seo-metric-box:hover {
    transform: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
  }
  
  .seo-cta-button:hover {
    transform: none;
  }
  
  .seo-cta-button:active {
    transform: scale(0.98);
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .seo-signal-card {
    border-width: 2px;
  }
  
  .seo-terminal {
    border-width: 2px;
    border-color: #fff;
  }
}
/* globales.css - Elegant Trend Analysis Styles */

/* Base Styles & Reset */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background: #000;
  color: #fff;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Selection Styling */
::selection {
  background: rgba(234, 179, 8, 0.3); /* yellow-500/30 */
}

/* Typography Scale */
.text-xs { font-size: 0.75rem; line-height: 1rem; }
.text-sm { font-size: 0.875rem; line-height: 1.25rem; }
.text-base { font-size: 1rem; line-height: 1.5rem; }
.text-lg { font-size: 1.125rem; line-height: 1.75rem; }
.text-xl { font-size: 1.25rem; line-height: 1.75rem; }
.text-2xl { font-size: 1.5rem; line-height: 2rem; }
.text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
.text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
.text-5xl { font-size: 3rem; line-height: 1; }
.text-6xl { font-size: 3.75rem; line-height: 1; }

/* Font Weights */
.font-medium { font-weight: 500; }
.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }

/* Tracking */
.tracking-tighter { letter-spacing: -0.05em; }
.tracking-widest { letter-spacing: 0.1em; }

/* Glass Morphism Card */
.glass-trend-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.glass-trend-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
}

/* SVG Glow Effect */
.filter-glow {
  filter: drop-shadow(0 0 8px currentColor);
  transition: all 0.5s ease-out;
}

/* Loading Animation */
@keyframes spin {
  to { transform: rotate(360deg); }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

/* Prose Content Styling */
.prose {
  max-width: none;
  color: #d4d4d8;
}

.prose h2 {
  font-size: 1.875rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

.prose p {
  margin-bottom: 1rem;
}

.prose .text-lg {
  font-size: 1.125rem;
  line-height: 1.75;
}

/* SEO Chip Links */
.seo-chip-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 2rem;
  color: #fff;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.seo-chip-link:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
  transform: translateY(-1px);
}

/* Grid System */
.grid { display: grid; }
.grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.md\:grid-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }
.md\:col-span-8 { grid-column: span 8 / span 8; }
.md\:col-span-4 { grid-column: span 4 / span 4; }

/* Flexbox Utilities */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }

/* Spacing */
.space-y-2 > * + * { margin-top: 0.5rem; }
.space-y-3 > * + * { margin-top: 0.75rem; }
.space-y-4 > * + * { margin-top: 1rem; }
.space-y-6 > * + * { margin-top: 1.5rem; }
.space-y-8 > * + * { margin-top: 2rem; }

.gap-2 { gap: 0.5rem; }
.gap-3 { gap: 0.75rem; }
.gap-4 { gap: 1rem; }
.gap-6 { gap: 1.5rem; }
.gap-8 { gap: 2rem; }
.gap-10 { gap: 2.5rem; }

/* Margin & Padding */
.m-0 { margin: 0; }
.mb-2 { margin-bottom: 0.5rem; }
.mb-3 { margin-bottom: 0.75rem; }
.mb-4 { margin-bottom: 1rem; }
.mb-5 { margin-bottom: 1.25rem; }
.mb-6 { margin-bottom: 1.5rem; }
.mb-8 { margin-bottom: 2rem; }

.mt-1 { margin-top: 0.25rem; }
.mt-2 { margin-top: 0.5rem; }
.mt-4 { margin-top: 1rem; }
.mt-6 { margin-top: 1.5rem; }
.mt-8 { margin-top: 2rem; }
.mt-20 { margin-top: 5rem; }
.mt-24 { margin-top: 6rem; }

.mx-auto { margin-left: auto; margin-right: auto; }

.p-2 { padding: 0.5rem; }
.p-3 { padding: 0.75rem; }
.p-4 { padding: 1rem; }
.p-6 { padding: 1.5rem; }
.p-8 { padding: 2rem; }

.px-2 { padding-left: 0.5rem; padding-right: 0.5rem; }
.px-3 { padding-left: 0.75rem; padding-right: 0.75rem; }
.px-4 { padding-left: 1rem; padding-right: 1rem; }
.px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }

.py-1 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
